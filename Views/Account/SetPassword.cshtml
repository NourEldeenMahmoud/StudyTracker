@model StudyTracker.Models.ViewModels.SetPasswordViewModel
@{
    ViewData["Title"] = "Set Password";
    Layout = "_UserLayout";
}

<main class="flex-1 w-full max-w-lg mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-8 sm:p-12">
        <div class="flex flex-col items-center mb-8 text-center">
            <div class="size-12 bg-primary/10 rounded-xl flex items-center justify-center mb-4 text-primary">
                <span class="material-symbols-outlined text-3xl">lock_reset</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Set a Password</h1>
            <p class="text-slate-500 dark:text-slate-400 text-sm">You signed up with an external account. Set a password to also log in with email.</p>
        </div>

        <form asp-action="SetPassword" method="post" class="flex flex-col gap-5">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div class="flex flex-col gap-2">
                <label class="text-sm font-medium text-slate-900 dark:text-slate-200 ml-1" asp-for="NewPassword">New Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                        <span class="material-symbols-outlined text-[20px]">lock</span>
                    </div>
                    <input asp-for="NewPassword" class="form-input block w-full rounded-xl border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-primary focus:ring-1 h-12 sm:h-14 pl-11 text-base transition-colors duration-200" placeholder="Create a password" />
                    <span asp-validation-for="NewPassword" class="text-red-500 text-xs mt-1"></span>
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-sm font-medium text-slate-900 dark:text-slate-200 ml-1" asp-for="ConfirmPassword">Confirm Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                        <span class="material-symbols-outlined text-[20px]">lock</span>
                    </div>
                    <input asp-for="ConfirmPassword" class="form-input block w-full rounded-xl border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-primary focus:ring-1 h-12 sm:h-14 pl-11 text-base transition-colors duration-200" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1"></span>
                </div>
            </div>

            <button type="submit" class="mt-2 w-full flex items-center justify-center rounded-xl bg-primary hover:bg-primary/90 text-white text-base font-bold h-12 sm:h-14 transition-all shadow-md shadow-primary/20 hover:shadow-lg hover:shadow-primary/30 hover:-translate-y-0.5 active:translate-y-0">
                Set Password
            </button>
        </form>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
