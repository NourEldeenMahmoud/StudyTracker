@model StudyTracker.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="w-full max-w-4xl p-4 sm:p-6">
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-[0_20px_60px_rgb(0,0,0,0.08)] dark:shadow-none border border-slate-100 dark:border-slate-700 overflow-hidden flex flex-col lg:flex-row min-h-[560px]">

        <!-- Left Branding Panel -->
        <div class="hidden lg:flex lg:w-5/12 bg-gradient-to-br from-primary via-blue-600 to-blue-800 p-10 flex-col justify-between relative overflow-hidden">
            <!-- Decorative circles -->
            <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-white/5"></div>
            <div class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full bg-white/5"></div>
            <div class="absolute top-1/2 right-4 w-20 h-20 rounded-full bg-white/5"></div>

            <!-- Logo & App Name -->
            <div class="relative z-10">
                <div class="size-14 bg-white/15 rounded-2xl flex items-center justify-center mb-5">
                    <span class="material-symbols-outlined text-white text-[30px]">school</span>
                </div>
                <h2 class="text-2xl font-bold text-white mb-2">StudyTracker</h2>
                <p class="text-blue-100 text-sm leading-relaxed">Your personal study companion. Track sessions, compete with friends, and stay consistent.</p>
            </div>

            <!-- Features -->
            <div class="relative z-10 space-y-4 my-8">
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-lg bg-white/15 flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-white text-[16px]">timer</span>
                    </div>
                    <p class="text-blue-100 text-sm">Focus timer with break tracking</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-lg bg-white/15 flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-white text-[16px]">leaderboard</span>
                    </div>
                    <p class="text-blue-100 text-sm">Weekly leaderboard &amp; rankings</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-lg bg-white/15 flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-white text-[16px]">emoji_events</span>
                    </div>
                    <p class="text-blue-100 text-sm">Earn badges for milestones</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="size-8 rounded-lg bg-white/15 flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-white text-[16px]">insights</span>
                    </div>
                    <p class="text-blue-100 text-sm">Detailed weekly progress stats</p>
                </div>
            </div>

            <!-- Bottom copyright -->
            <p class="relative z-10 text-blue-200/60 text-xs">© @DateTime.Now.Year StudyTracker</p>
        </div>

        <!-- Right Form Panel -->
        <div class="flex-1 p-8 sm:p-10 flex flex-col justify-center">
            <!-- Header -->
            <div class="mb-7">
                <div class="size-10 bg-primary/10 rounded-xl flex items-center justify-center mb-4 text-primary lg:hidden">
                    <span class="material-symbols-outlined text-2xl">school</span>
                </div>
                <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Welcome back</h1>
                <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Sign in to your account to continue.</p>
            </div>

            <!-- Login Form -->
            <form asp-action="Login" method="post" class="flex flex-col gap-4">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 dark:bg-red-900/20 rounded-lg px-3 py-2"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Email -->
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wide" asp-for="Email">Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">mail</span>
                        </div>
                        <input asp-for="Email" class="form-input block w-full rounded-xl border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-primary focus:ring-1 h-11 pl-10 text-sm transition-colors" placeholder="student@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                </div>

                <!-- Password -->
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wide" asp-for="Password">Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">lock</span>
                        </div>
                        <input asp-for="Password" id="passwordInput" class="form-input block w-full rounded-xl border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-primary focus:ring-1 h-11 pl-10 pr-11 text-sm transition-colors" placeholder="••••••••" />
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors">
                            <span id="eyeIcon" class="material-symbols-outlined text-[18px]">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                </div>

                <!-- Remember me -->
                <label class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 -mt-1">
                    <input asp-for="RememberMe" type="checkbox" class="rounded border-slate-300 text-primary focus:ring-primary" />
                    <span>Remember me</span>
                </label>

                <!-- Submit -->
                <button type="submit" class="w-full flex items-center justify-center rounded-xl bg-primary hover:bg-primary/90 text-white text-sm font-bold h-11 transition-all shadow-md shadow-primary/20 hover:-translate-y-0.5 active:translate-y-0 mt-1">
                    Log In
                </button>
            </form>

            <!-- OAuth -->
            <div class="flex items-center gap-3 my-5">
                <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
                <span class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider font-medium">or</span>
                <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
            </div>

            <div class="flex flex-col gap-2.5">
                <form asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Google" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full flex items-center justify-center gap-2.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900/50 h-11 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
                        <svg class="w-4 h-4" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        Continue with Google
                    </button>
                </form>
                <form asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Discord" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full flex items-center justify-center gap-2.5 rounded-xl bg-[#5865F2] h-11 text-sm font-medium text-white hover:bg-[#4752C4] transition-all shadow-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                        </svg>
                        Continue with Discord
                    </button>
                </form>
            </div>

            <!-- Footer -->
            <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-6">
                Don't have an account?
                <a asp-action="Register" class="font-bold text-primary hover:text-primary/80 ml-1 transition-colors">Register</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePasswordVisibility() {
            const input = document.getElementById('passwordInput');
            const icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') { input.type = 'text'; icon.textContent = 'visibility_off'; }
            else { input.type = 'password'; icon.textContent = 'visibility'; }
        }
    </script>
}
