@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="w-full max-w-md p-6">
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-[0_20px_60px_rgb(0,0,0,0.08)] dark:shadow-none border border-slate-100 dark:border-slate-700 p-8 text-center animate-fade-in">
        <!-- Shield Lock Icon -->
        <div class="w-20 h-20 bg-red-50 dark:bg-red-950/30 rounded-2xl flex items-center justify-center mx-auto mb-6 text-red-500">
            <span class="material-symbols-outlined text-[48px]">gpp_bad</span>
        </div>

        <h1 class="text-2xl font-bold text-slate-800 dark:text-white mb-3">Access Denied</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-8">
            You do not have the required permissions to access this page. Please contact your administrator if you think this is a mistake.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col gap-3">
            <a href="@Url.Action("Index", "Dashboard")" class="w-full py-3 px-4 bg-primary hover:bg-blue-600 text-white font-medium rounded-xl transition duration-200 shadow-lg shadow-blue-500/25">
                Go to Dashboard
            </a>
            <a href="@Url.Action("Login", "Account")" class="w-full py-3 px-4 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/50 text-slate-700 dark:text-slate-300 font-medium rounded-xl transition duration-200">
                Log in with another account
            </a>
        </div>
    </div>
</div>
