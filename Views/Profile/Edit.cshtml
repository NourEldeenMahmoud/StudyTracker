@model StudyTracker.Models.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
    Layout = "_UserLayout";
    var userName = ViewBag.UserName as string ?? "User";
}

<main class="flex-grow flex justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col w-full max-w-[600px]">
        <div class="mb-8">
            <div class="flex flex-col gap-2">
                <h1 class="text-slate-900 dark:text-white text-3xl sm:text-4xl font-black leading-tight tracking-tight">Edit Profile</h1>
                <p class="text-slate-500 dark:text-slate-400 text-base sm:text-lg font-normal">Update your account information.</p>
            </div>
        </div>
        
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 lg:p-10 shadow-sm border border-slate-100 dark:border-slate-800">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="profileForm" class="flex flex-col gap-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
                
                <!-- Profile Picture -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium">Profile Picture</label>
                    <div class="flex items-center gap-4">
                        <div class="relative">
                            @if (!string.IsNullOrEmpty(Model.CurrentProfilePictureUrl))
                            {
                                <img id="profilePreview" src="@Model.CurrentProfilePictureUrl" alt="Profile Picture" class="size-20 rounded-full object-cover border-2 border-slate-200 dark:border-slate-700" />
                            }
                            else
                            {
                                <div id="profilePreview" class="size-20 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300 font-semibold text-xl border-2 border-slate-200 dark:border-slate-700">
                                    @Model.FullName.Substring(0, 1).ToUpper()
                                </div>
                            }
                        </div>
                        <div class="flex-1">
                            <input id="imageInput" type="file" accept="image/jpeg,image/jpg,image/png,image/gif" class="w-full text-sm text-slate-500 dark:text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-blue-600 file:cursor-pointer cursor-pointer" />
                            <input asp-for="ProfilePicture" type="file" accept="image/jpeg,image/jpg,image/png,image/gif" id="profilePictureInput" style="display: none;" />
                            <span asp-validation-for="ProfilePicture" class="text-red-500 text-xs mt-1"></span>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">JPG, PNG, or GIF. Max 5MB. Click to crop and resize.</p>
                        </div>
                    </div>
                </div>
                
                <!-- Image Cropper Modal -->
                <div id="imageCropperModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-slate-900/60 backdrop-blur-sm" onclick="closeCropper()">
                    <div class="w-full max-w-2xl mx-4 bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-xl border border-slate-100 dark:border-slate-800" onclick="event.stopPropagation()">
                        <div class="flex items-start justify-between gap-4 mb-4">
                            <div>
                                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Crop & Resize Image</h2>
                                <p class="text-slate-500 dark:text-slate-400 text-sm">Adjust your profile picture to fit perfectly.</p>
                            </div>
                            <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" onclick="closeCropper()">
                                <span class="material-symbols-outlined text-[24px]">close</span>
                            </button>
                        </div>
                        <div class="mb-4">
                            <div id="imageContainer" class="max-h-[500px] overflow-hidden bg-slate-100 dark:bg-slate-800 rounded-lg">
                                <img id="cropperImage" src="" alt="Crop" style="max-width: 100%; display: block;" />
                            </div>
                        </div>
                        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                            <button type="button" class="px-4 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm font-medium" onclick="closeCropper()">
                                Cancel
                            </button>
                            <button type="button" id="cropButton" class="px-6 py-2 rounded-lg bg-primary hover:bg-blue-600 text-white font-semibold text-sm shadow-md shadow-blue-500/30 transition-all">
                                Crop & Use
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium" asp-for="FullName">Full Name</label>
                    <div class="relative group">
                        <input asp-for="FullName" class="w-full h-14 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-base" />
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined">person</span>
                        </div>
                        <span asp-validation-for="FullName" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>
                
                <div class="flex items-center justify-end gap-4 mt-4 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <a asp-action="Index" class="px-6 py-3 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white font-medium transition-colors text-sm">
                        Cancel
                    </a>
                    <button type="submit" class="px-8 py-3 rounded-xl bg-primary hover:bg-blue-600 text-white font-bold text-sm shadow-lg shadow-blue-500/30 transition-all hover:shadow-blue-500/40 hover:-translate-y-0.5 active:translate-y-0">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- Cropper.js CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
    <!-- Cropper.js JS -->
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
    
    <script>
        let cropper;
        let cropperImage;
        
        document.getElementById('imageInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // Validate file size (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    showNotification('File size must be less than 5MB.', 'warning');
                    e.target.value = '';
                    return;
                }
                
                // Validate file type
                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                if (!allowedTypes.includes(file.type)) {
                    showNotification('Only JPG, PNG, and GIF files are allowed.', 'warning');
                    e.target.value = '';
                    return;
                }
                
                const reader = new FileReader();
                reader.onload = function(event) {
                    cropperImage = document.getElementById('cropperImage');
                    cropperImage.src = event.target.result;
                    
                    // Destroy existing cropper if any
                    if (cropper) {
                        cropper.destroy();
                    }
                    
                    // Initialize cropper
                    cropper = new Cropper(cropperImage, {
                        aspectRatio: 1, // Square (1:1)
                        viewMode: 1,
                        dragMode: 'move',
                        autoCropArea: 0.8,
                        restore: false,
                        guides: true,
                        center: true,
                        highlight: false,
                        cropBoxMovable: true,
                        cropBoxResizable: true,
                        toggleDragModeOnDblclick: false,
                        minCropBoxWidth: 100,
                        minCropBoxHeight: 100,
                    });
                    
                    // Show modal
                    document.getElementById('imageCropperModal').classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });
        
        document.getElementById('cropButton').addEventListener('click', function() {
            if (cropper) {
                // Get cropped canvas
                const canvas = cropper.getCroppedCanvas({
                    width: 400,
                    height: 400,
                    imageSmoothingEnabled: true,
                    imageSmoothingQuality: 'high',
                });
                
                // Convert canvas to blob
                canvas.toBlob(function(blob) {
                    // Create a new File from the blob
                    const file = new File([blob], 'profile-picture.jpg', { type: 'image/jpeg' });
                    
                    // Set the file to the hidden input using DataTransfer
                    const profilePictureInput = document.getElementById('profilePictureInput');
                    
                    try {
                        // Create a DataTransfer object to set the file
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(file);
                        profilePictureInput.files = dataTransfer.files;
                        
                        // Verify file was set
                        if (profilePictureInput.files && profilePictureInput.files.length > 0) {
                            console.log('File set successfully:', profilePictureInput.files[0].name, profilePictureInput.files[0].size);
                        } else {
                            console.error('Failed to set file to input');
                        }
                        
                        // Trigger change event to ensure form binding works
                        const changeEvent = new Event('change', { bubbles: true });
                        profilePictureInput.dispatchEvent(changeEvent);
                    } catch (error) {
                        console.error('Error setting file:', error);
                        showNotification('Error setting image file. Please try again.', 'error');
                    }
                    
                    // Update preview
                    const preview = document.getElementById('profilePreview');
                    const previewUrl = URL.createObjectURL(blob);
                    
                    if (preview.tagName === 'IMG') {
                        preview.src = previewUrl;
                    } else {
                        const img = document.createElement('img');
                        img.id = 'profilePreview';
                        img.src = previewUrl;
                        img.className = 'size-20 rounded-full object-cover border-2 border-slate-200 dark:border-slate-700';
                        img.alt = 'Profile Picture';
                        preview.parentNode.replaceChild(img, preview);
                    }
                    
                    // Clean up
                    setTimeout(() => URL.revokeObjectURL(previewUrl), 100);
                    
                    // Close modal
                    closeCropper();
                }, 'image/jpeg', 0.9);
            }
        });
        
        function closeCropper() {
            document.getElementById('imageCropperModal').classList.add('hidden');
            document.getElementById('imageInput').value = '';
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
        }
        
        // Ensure file is submitted with form
        document.getElementById('profileForm').addEventListener('submit', function(e) {
            const profilePictureInput = document.getElementById('profilePictureInput');
            if (profilePictureInput && profilePictureInput.files && profilePictureInput.files.length > 0) {
                console.log('Profile picture file is ready:', profilePictureInput.files[0].name);
            } else {
                console.log('No profile picture file selected');
            }
        });
    </script>
}
