@{
    ViewData["Title"] = "Super Admin Panel";
    Layout = "_AdminLayout";
    var logs = ViewBag.RecentLogs as List<StudyTracker.Models.SecurityLog> ?? new();
}

<header class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Super Admin Panel</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-1">High-privilege tools and security activity, available only to Super Admins.</p>
    </div>
</header>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-6 lg:col-span-2">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Recent security events</h3>
            <span class="text-xs text-slate-400">Last @logs.Count entries</span>
        </div>

        @if (!logs.Any())
        {
            <p class="text-sm text-slate-500 dark:text-slate-400">No security events logged yet.</p>
        }
        else
        {
            <div class="overflow-x-auto -mx-3">
                <table class="min-w-full text-left border-collapse">
                    <thead>
                        <tr class="text-[11px] uppercase tracking-wider text-slate-400 dark:text-slate-500 border-b border-slate-100 dark:border-slate-700">
                            <th class="px-3 py-2">Time (UTC)</th>
                            <th class="px-3 py-2">User</th>
                            <th class="px-3 py-2">Action</th>
                            <th class="px-3 py-2">Target</th>
                            <th class="px-3 py-2">IP</th>
                        </tr>
                    </thead>
                    <tbody class="text-xs divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var log in logs)
                        {
                            <tr>
                                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@TimeZoneHelper.ToCairo(log.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="px-3 py-2">
                                    <div class="flex flex-col">
                                        <span class="text-slate-900 dark:text-white font-medium">@log.Email ?? "Unknown"</span>
                                        <span class="text-[10px] text-slate-400">Id: @log.UserId</span>
                                    </div>
                                </td>
                                <td class="px-3 py-2 text-slate-700 dark:text-slate-200">@log.Action</td>
                                <td class="px-3 py-2">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-[11px] text-slate-700 dark:text-slate-200">
                                        <span class="font-semibold">@log.TargetType</span>
                                        @if (!string.IsNullOrWhiteSpace(log.TargetId))
                                        {
                                            <span class="text-slate-400">/</span>
                                            <span class="truncate max-w-[120px]">@log.TargetId</span>
                                        }
                                    </span>
                                </td>
                                <td class="px-3 py-2 text-slate-500 dark:text-slate-400">@log.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">Capabilities</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
            As a Super Admin you can manage other admins, review security activity, and access system-wide tools.
        </p>
        <ul class="space-y-2 text-sm text-slate-700 dark:text-slate-200">
            <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[18px] text-primary mt-0.5">admin_panel_settings</span>
                <span>Promote or demote administrators, and manage high-privilege access.</span>
            </li>
            <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[18px] text-red-500 mt-0.5">delete_forever</span>
                <span>Delete users, sessions, and badges when strictly necessary.</span>
            </li>
            <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-[18px] text-amber-500 mt-0.5">warning</span>
                <span>Review and audit unauthorized delete attempts.</span>
            </li>
        </ul>
    </section>
</div>

