    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_NotificationSystem")

    @if (User.Identity?.IsAuthenticated == true)
    {
    <script>
        // ── Theme toggle (dark / light) ──────────────────────────────
        (function () {
            const STORAGE_KEY = 'studytracker-theme';
            const root = document.documentElement;

            function applyTheme(theme) {
                if (theme === 'dark') {
                    root.classList.add('dark');
                } else {
                    root.classList.remove('dark');
                }
                const icon = document.getElementById('themeToggleIcon');
                if (icon) {
                    icon.textContent = root.classList.contains('dark') ? 'light_mode' : 'dark_mode';
                }
            }

            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved === 'dark' || saved === 'light') {
                applyTheme(saved);
            }

            const btn = document.getElementById('themeToggle');
            if (btn) {
                btn.addEventListener('click', () => {
                    const next = root.classList.contains('dark') ? 'light' : 'dark';
                    localStorage.setItem(STORAGE_KEY, next);
                    applyTheme(next);
                });
            }
        })();

        // ── Render a badge icon — supports Material Symbols, emojis, uploaded images ──
        function renderBadgeIcon(icon, cls) {
            if (icon && (icon.startsWith('/') || icon.startsWith('http')))
                return `<img src="${icon}" class="inline-block w-6 h-6 object-cover rounded-full align-middle" />`;
            if (/^[a-z0-9_]+$/.test(icon))
                return `<span class="material-symbols-outlined ${cls}">${icon}</span>`;
            return `<span class="${cls} leading-none">${icon}</span>`;
        }

        // ── Hover tooltip for badges (bigger icon + description) ─────────
        let badgeHoverTooltip = null;

        function ensureBadgeHoverTooltip() {
            if (badgeHoverTooltip) return badgeHoverTooltip;
            const el = document.createElement('div');
            el.id = 'badge-hover-tooltip';
            el.className = 'fixed z-[260] hidden pointer-events-none';
            document.body.appendChild(el);
            badgeHoverTooltip = el;
            return el;
        }

        function showBadgeHoverTooltip(trigger) {
            const name = trigger.getAttribute('data-badge-name') || '';
            const desc = trigger.getAttribute('data-badge-description') || '';
            const icon = trigger.getAttribute('data-badge-icon') || '';
            const tooltip = ensureBadgeHoverTooltip();

            const iconHtml = renderBadgeIcon(icon, 'text-yellow-400 text-[26px]');
            tooltip.innerHTML = `
                <div class="rounded-2xl bg-slate-900/95 text-white shadow-2xl px-3 py-2 border border-slate-700 max-w-xs">
                    <div class="flex items-start gap-2">
                        <div class="shrink-0">
                            ${iconHtml}
                        </div>
                        <div class="min-w-0">
                            <p class="text-[13px] font-semibold leading-snug truncate">${name}</p>
                            ${desc ? `<p class="text-[11px] text-slate-200 leading-snug mt-0.5">${desc}</p>` : ''}
                        </div>
                    </div>
                </div>`;

            tooltip.style.opacity = '0';
            tooltip.classList.remove('hidden');

            const rect = trigger.getBoundingClientRect();
            const tipRect = tooltip.firstElementChild.getBoundingClientRect();
            const top = window.scrollY + rect.top - tipRect.height - 8;
            const left = window.scrollX + rect.left + rect.width / 2 - tipRect.width / 2;

            tooltip.style.top = `${Math.max(8, top)}px`;
            tooltip.style.left = `${Math.max(8, left)}px`;
            tooltip.style.opacity = '1';
        }

        function hideBadgeHoverTooltip() {
            if (!badgeHoverTooltip) return;
            badgeHoverTooltip.classList.add('hidden');
        }

        // ── Global badge toast notification ──────────────────────────────
        function showBadgeNotification(name, icon, description) {
            const existing = document.querySelectorAll('.badge-toast');
            const offset = existing.length * 88; // stack downward
            const toast = document.createElement('div');
            toast.className = 'badge-toast fixed z-[300] flex items-center gap-3 bg-white dark:bg-slate-800 border border-yellow-300 dark:border-yellow-600 rounded-2xl shadow-2xl px-4 py-3 max-w-[min(20rem,calc(100vw-1.5rem))] transform -translate-y-4 opacity-0 transition-all duration-500';
            toast.style.top = (72 + offset) + 'px';
            toast.style.right = '12px';
            toast.innerHTML = `
                <div class="flex-shrink-0 w-11 h-11 rounded-full bg-yellow-100 dark:bg-yellow-900/40 flex items-center justify-center">
                    ${renderBadgeIcon(icon, 'text-yellow-500 text-[24px]')}
                </div>
                <div class="min-w-0">
                    <p class="text-xs font-semibold text-yellow-600 dark:text-yellow-400 uppercase tracking-wider mb-0.5">Badge Earned!</p>
                    <p class="text-sm font-bold text-slate-900 dark:text-white leading-tight">${name}</p>
                    ${description ? `<p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-2">${description}</p>` : ''}
                </div>
                <span class="material-symbols-outlined text-[16px] text-slate-300 dark:text-slate-600 ml-auto shrink-0 cursor-pointer hover:text-slate-500 self-start" onclick="this.closest('.badge-toast').remove()">close</span>
            `;
            document.body.appendChild(toast);
            requestAnimationFrame(() => requestAnimationFrame(() => {
                toast.classList.remove('-translate-y-4', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
            }));
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-4', 'opacity-0');
                setTimeout(() => toast.remove(), 500);
            }, 5500);
        }

        // ── Auto-check for pending badge notifications on every page load ──
        (async function checkPendingBadges() {
            try {
                const res = await fetch('/Badge/PendingNotifications', { credentials: 'same-origin' });
                if (!res.ok) return;
                const data = await res.json();
                if (!data.badges || data.badges.length === 0) return;
                // Delay slightly so the page has settled, then show one by one
                setTimeout(() => {
                    data.badges.forEach((badge, i) => {
                        setTimeout(() => {
                            showBadgeNotification(badge.name, badge.icon, badge.description);
                        }, i * 1800);
                    });
                }, 800);
            } catch (_) { /* silently ignore */ }
        })();
        </script>
    }

    <script>
        // ── Mini profile tooltip for avatars ─────────────────────────────
        (function () {
            const cache = {};
            let tooltipEl;
            let activeAvatar = null;

            function ensureTooltip() {
                if (tooltipEl) return tooltipEl;
                tooltipEl = document.createElement('div');
                tooltipEl.id = 'mini-profile-tooltip';
                tooltipEl.className = 'fixed z-[260] hidden pointer-events-none';
                document.body.appendChild(tooltipEl);
                return tooltipEl;
            }

            async function fetchMiniProfile(userId) {
                if (cache[userId]) return cache[userId];
                try {
                    const res = await fetch(`/Profile/MiniProfile?userId=${encodeURIComponent(userId)}`, {
                        credentials: 'same-origin'
                    });
                    if (!res.ok) return null;
                    const data = await res.json();
                    cache[userId] = data;
                    return data;
                } catch {
                    return null;
                }
            }

            function buildTooltipHtml(data) {
                const hrs = (data.totalHours || 0).toFixed(1);
                const todayMins = data.todayMinutes || 0;
                const streak = data.streak || 0;
                const badges = data.badges || [];

                const badgeHtml = badges.map(b =>
                    `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full ${b.color || ''} overflow-hidden">
                        ${renderBadgeIcon(b.icon, 'text-[18px]')}
                    </span>`).join('');

                const weekRank = data.weeklyRank > 0 ? `#${data.weeklyRank}` : '—';
                const dayRank = data.dailyRank > 0 ? `#${data.dailyRank}` : '—';

                return `
                <div class="rounded-2xl bg-slate-900/95 text-white shadow-2xl px-3 py-2.5 border border-slate-700 max-w-xs">
                    <div class="flex items-start gap-3">
                        <div class="shrink-0">
                            <div class="w-10 h-10 rounded-full bg-slate-700 overflow-hidden flex items-center justify-center">
                                ${data.profilePictureUrl
                                    ? `<img src="${data.profilePictureUrl}" class="w-full h-full object-cover" />`
                                    : `<span class="text-sm font-semibold">${(data.fullName || '?')[0] ?? '?'}</span>`}
                            </div>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-semibold leading-snug truncate">${data.fullName || 'User'}</p>
                            <div class="flex flex-wrap gap-1 mt-1 text-[10px] text-slate-300">
                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-slate-800">
                                    <span class="material-symbols-outlined text-[12px]">today</span>
                                    <span>Daily rank ${dayRank}</span>
                                </span>
                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-slate-800">
                                    <span class="material-symbols-outlined text-[12px]">calendar_view_week</span>
                                    <span>Weekly rank ${weekRank}</span>
                                </span>
                            </div>
                            <div class="mt-1 text-[11px] text-slate-200">
                                <span class="inline-flex items-center gap-1 mr-2">
                                    <span class="material-symbols-outlined text-[12px]">schedule</span>
                                    <span>${hrs}h total</span>
                                </span>
                                <span class="inline-flex items-center gap-1 mr-2">
                                    <span class="material-symbols-outlined text-[12px]">bolt</span>
                                    <span>${todayMins}m today</span>
                                </span>
                                <span class="inline-flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[12px]">local_fire_department</span>
                                    <span>${streak} day streak</span>
                                </span>
                            </div>
                            ${badgeHtml
                                ? `<div class="flex flex-wrap items-center gap-1.5 mt-2 max-w-[16rem]">${badgeHtml}</div>`
                                : ''}
                            <a href="#" class="inline-flex items-center gap-1 text-[11px] text-primary mt-2 underline decoration-primary/50 decoration-dotted hover:text-primary/80"
                               data-mini-profile-full-link="1">
                                <span class="material-symbols-outlined text-[12px]">person</span>
                                <span>View full profile</span>
                            </a>
                        </div>
                    </div>
                </div>`;
            }

            function positionTooltip(trigger, tooltip) {
                const rect = trigger.getBoundingClientRect();
                const content = tooltip.firstElementChild;
                if (!content) return;
                const tipRect = content.getBoundingClientRect();

                // Prefer showing below the avatar
                let top = window.scrollY + rect.bottom + 8;
                let left = window.scrollX + rect.left + rect.width / 2 - tipRect.width / 2;

                // Clamp horizontally
                const minLeft = window.scrollX + 8;
                const maxLeft = window.scrollX + window.innerWidth - tipRect.width - 8;
                if (left < minLeft) left = minLeft;
                if (left > maxLeft) left = maxLeft;

                // If tooltip would go below viewport, flip above
                const bottom = top + tipRect.height;
                const viewportBottom = window.scrollY + window.innerHeight - 8;
                if (bottom > viewportBottom) {
                    top = window.scrollY + rect.top - tipRect.height - 8;
                }

                tooltip.style.top = `${top}px`;
                tooltip.style.left = `${left}px`;
            }

            async function showTooltipForAvatar(avatar) {
                const userId = avatar.getAttribute('data-user-id');
                if (!userId) return;

                const data = await fetchMiniProfile(userId);
                if (!data) return;

                activeAvatar = avatar;

                const tip = ensureTooltip();
                tip.innerHTML = buildTooltipHtml(data);
                tip.classList.remove('hidden');
                tip.style.opacity = '0';

                document.querySelectorAll('[data-mini-profile-full-link]').forEach(link => {
                    link.addEventListener('click', evt => {
                        evt.preventDefault();
                        window.location.href = `/Profile/Public?userId=${encodeURIComponent(userId)}`;
                    });
                });

                requestAnimationFrame(() => {
                    positionTooltip(avatar, tip);
                    tip.style.opacity = '1';
                });
            }

            function hideTooltip() {
                activeAvatar = null;
                if (!tooltipEl) return;
                tooltipEl.classList.add('hidden');
            }

            function handleEnter(e) {
                const avatar = e.currentTarget;
                if (!(avatar instanceof HTMLElement)) return;
                avatar.style.cursor = 'pointer';
                showTooltipForAvatar(avatar);
            }

            function handleLeave() {
                hideTooltip();
            }

            function handleClick(e) {
                const avatar = e.currentTarget;
                if (!(avatar instanceof HTMLElement)) return;
                const userId = avatar.getAttribute('data-user-id');
                if (!userId) return;
                window.location.href = `/Profile/Public?userId=${encodeURIComponent(userId)}`;
            }

            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.user-avatar[data-user-id]').forEach(el => {
                    el.addEventListener('mouseenter', handleEnter);
                    el.addEventListener('mouseleave', handleLeave);
                    el.addEventListener('click', handleClick);
                    el.style.cursor = 'pointer';
                });
            });
        })();

        // ── Notification dropdown ─────────────────────────────────────
        (function () {
            const bell = document.getElementById('notificationBell');
            const dropdown = document.getElementById('notificationDropdown');
            const list = document.getElementById('notificationList');
            const badge = document.getElementById('notificationBadge');
            const markAllBtn = document.getElementById('notificationMarkAll');

            if (!bell || !dropdown || !list || !badge || !markAllBtn) return;

            async function updateBadgeOnly() {
                try {
                    const res = await fetch('/Notification/UnreadCount', { credentials: 'same-origin' });
                    if (!res.ok) return;
                    const data = await res.json();
                    const count = typeof data.count === 'number' ? data.count : 0;
                    if (count > 0) {
                        badge.textContent = count > 9 ? '9+' : String(count);
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                    } else {
                        badge.classList.add('hidden');
                    }
                } catch { /* ignore */ }
            }

            async function loadNotifications() {
                try {
                    const res = await fetch('/Notification/Recent', { credentials: 'same-origin' });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (!data.success) return;
                    const items = data.notifications || [];

                    if (!items.length) {
                        list.innerHTML = '<div class="px-4 py-6 text-center text-xs text-slate-400 dark:text-slate-500">No notifications yet.</div>';
                        badge.classList.add('hidden');
                        return;
                    }

                    let unread = 0;
                    const parts = items.map(n => {
                        if (!n.isRead) unread++;
                        const created = n.createdAtUtc ? new Date(n.createdAtUtc) : null;
                        let when = '';
                        if (created) {
                            const diff = (Date.now() - created.getTime()) / 60000;
                            if (diff < 1) when = 'just now';
                            else if (diff < 60) when = `${Math.round(diff)} min ago`;
                            else if (diff < 60 * 24) when = `${Math.round(diff / 60)} h ago`;
                            else when = created.toLocaleDateString();
                        }

                        return `
                            <button type="button"
                                    class="w-full text-left px-4 py-3 flex items-start gap-3 text-xs ${n.isRead ? 'bg-white dark:bg-slate-900' : 'bg-blue-50/70 dark:bg-slate-800'}">
                                <span class="mt-0.5 material-symbols-outlined text-[18px] ${n.isRead ? 'text-slate-400' : 'text-primary'}">
                                    ${n.type === 'BadgeEarned' ? 'workspace_premium' :
                                        n.type === 'StreakRisk' ? 'local_fire_department' :
                                        n.type === 'Milestone' ? 'milestone' :
                                        n.type === 'RankDrop' ? 'trending_down' : 'notifications'}
                                </span>
                                <span class="flex-1 min-w-0">
                                    <span class="block text-slate-800 dark:text-slate-100">${n.message}</span>
                                    ${when ? `<span class="block text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">${when}</span>` : ''}
                                </span>
                            </button>`;
                    }).join('');

                    list.innerHTML = parts;

                    if (unread > 0) {
                        badge.textContent = unread > 9 ? '9+' : String(unread);
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                    } else {
                        badge.classList.add('hidden');
                    }
                } catch {
                    list.innerHTML = '<div class="px-4 py-6 text-center text-xs text-red-500">Failed to load notifications.</div>';
                }
            }

            updateBadgeOnly();
            setInterval(updateBadgeOnly, 60000);
            window.refreshNotificationBadge = updateBadgeOnly;

            function toggleDropdown() {
                const isHidden = dropdown.classList.contains('hidden');
                if (isHidden) {
                    dropdown.classList.remove('hidden');
                    loadNotifications();
                } else {
                    dropdown.classList.add('hidden');
                }
            }

            bell.addEventListener('click', (e) => {
                e.stopPropagation();
                toggleDropdown();
            });

            markAllBtn.addEventListener('click', async (e) => {
                e.stopPropagation();
                try {
                    await fetch('/Notification/MarkAllRead', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({})
                    });
                    await loadNotifications();
                    await updateBadgeOnly();
                } catch {
                    showNotification('Could not mark notifications as read.', 'error');
                }
            });

            document.addEventListener('click', (e) => {
                if (!dropdown.classList.contains('hidden') &&
                    !dropdown.contains(e.target) &&
                    !bell.contains(e.target)) {
                    dropdown.classList.add('hidden');
                }
            });
        })();

        // ── Mobile theme toggle ──────────────────────────────────────
        (function () {
            const STORAGE_KEY = 'studytracker-theme';
            const root = document.documentElement;
            const mobileBtn = document.getElementById('themeToggleMobile');
            const mobileIcon = document.getElementById('themeToggleIconMobile');

            function syncMobileIcon() {
                if (!mobileIcon) return;
                mobileIcon.textContent = root.classList.contains('dark') ? 'light_mode' : 'dark_mode';
            }

            syncMobileIcon();

            if (mobileBtn) {
                mobileBtn.addEventListener('click', () => {
                    const next = root.classList.contains('dark') ? 'light' : 'dark';
                    localStorage.setItem(STORAGE_KEY, next);
                    if (next === 'dark') root.classList.add('dark'); else root.classList.remove('dark');
                    const icon = document.getElementById('themeToggleIcon');
                    if (icon) icon.textContent = root.classList.contains('dark') ? 'light_mode' : 'dark_mode';
                    syncMobileIcon();
                });
            }
        })();

        // ── Mobile notification dropdown ──────────────────────────────
        (function () {
            const bell = document.getElementById('notificationBellMobile');
            const dropdown = document.getElementById('notificationDropdownMobile');
            const list = document.getElementById('notificationListMobile');
            const badge = document.getElementById('notificationBadgeMobile');
            const markAllBtn = document.getElementById('notificationMarkAllMobile');

            if (!bell || !dropdown || !list || !badge) return;

            async function loadMobileNotifications() {
                try {
                    const res = await fetch('/Notification/Recent', { credentials: 'same-origin' });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (!data.success) return;
                    const items = data.notifications || [];

                    if (!items.length) {
                        list.innerHTML = '<div class="px-4 py-6 text-center text-xs text-slate-400 dark:text-slate-500">No notifications yet.</div>';
                        badge.classList.add('hidden');
                        return;
                    }

                    let unread = 0;
                    const parts = items.map(n => {
                        if (!n.isRead) unread++;
                        const created = n.createdAtUtc ? new Date(n.createdAtUtc) : null;
                        let when = '';
                        if (created) {
                            const diff = (Date.now() - created.getTime()) / 60000;
                            if (diff < 1) when = 'just now';
                            else if (diff < 60) when = `${Math.round(diff)}m ago`;
                            else if (diff < 60 * 24) when = `${Math.round(diff / 60)}h ago`;
                            else when = created.toLocaleDateString();
                        }
                        return `
                            <button type="button"
                                    class="w-full text-left px-4 py-3 flex items-start gap-3 text-xs ${n.isRead ? 'bg-white dark:bg-slate-900' : 'bg-blue-50/70 dark:bg-slate-800'}">
                                <span class="mt-0.5 material-symbols-outlined text-[18px] ${n.isRead ? 'text-slate-400' : 'text-primary'}">
                                    ${n.type === 'BadgeEarned' ? 'workspace_premium' : n.type === 'StreakRisk' ? 'local_fire_department' : 'notifications'}
                                </span>
                                <span class="flex-1 min-w-0">
                                    <span class="block text-slate-800 dark:text-slate-100">${n.message}</span>
                                    ${when ? `<span class="block text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">${when}</span>` : ''}
                                </span>
                            </button>`;
                    }).join('');

                    list.innerHTML = parts;
                    if (unread > 0) {
                        badge.textContent = unread > 9 ? '9+' : String(unread);
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                    } else {
                        badge.classList.add('hidden');
                    }
                } catch { list.innerHTML = '<div class="px-4 py-6 text-center text-xs text-red-500">Failed to load.</div>'; }
            }

            bell.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = dropdown.classList.contains('hidden');
                if (isHidden) { dropdown.classList.remove('hidden'); loadMobileNotifications(); }
                else { dropdown.classList.add('hidden'); }
            });

            if (markAllBtn) {
                markAllBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    try {
                        await fetch('/Notification/MarkAllRead', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                            body: JSON.stringify({})
                        });
                        await loadMobileNotifications();
                    } catch {}
                });
            }

            document.addEventListener('click', (e) => {
                if (!dropdown.classList.contains('hidden') && !dropdown.contains(e.target) && !bell.contains(e.target)) {
                    dropdown.classList.add('hidden');
                }
            });

            // Sync badge count with desktop bell
            async function syncMobileBadge() {
                try {
                    const res = await fetch('/Notification/UnreadCount', { credentials: 'same-origin' });
                    if (!res.ok) return;
                    const data = await res.json();
                    const count = typeof data.count === 'number' ? data.count : 0;
                    if (count > 0) {
                        badge.textContent = count > 9 ? '9+' : String(count);
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                    } else { badge.classList.add('hidden'); }
                } catch {}
            }
            syncMobileBadge();
            setInterval(syncMobileBadge, 60000);
        })();

        // ── Timer expiry check (runs on every page) ──────────────────
        (function () {
            const uid = '@Html.Raw(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")';
            if (!uid) return;
            const key = 'focusSessionState_' + uid;

            function tryPlayAlarm() {
                try {
                    const a = new Audio('/alarm.mp3');
                    a.volume = 0.8;
                    a.play().catch(() => {});
                } catch (_) {}
            }

            function showToast(msg) {
                const t = document.createElement('div');
                t.style.cssText = [
                    'position:fixed','top:72px','right:12px','z-index:99999',
                    'background:#4f46e5','color:#fff','padding:14px 18px',
                    'border-radius:14px','font-size:14px','font-weight:600',
                    'box-shadow:0 8px 30px rgba(79,70,229,.35)','max-width:min(320px,calc(100vw - 24px))',
                    'display:flex','flex-direction:column','gap:6px','cursor:pointer'
                ].join(';');
                t.innerHTML = '<span>&#9200; Focus session complete!</span>'
                    + '<a href="/Dashboard" style="font-size:12px;color:#c7d2fe;text-decoration:underline;">Go to Dashboard &rarr;</a>';
                t.onclick = () => t.remove();
                document.body.appendChild(t);
                setTimeout(() => { if (t.parentNode) t.remove(); }, 9000);
            }

            function fireNotification() {
                try {
                    if (Notification.permission === 'granted') {
                        new Notification('StudyTracker', {
                            body: 'Your focus session has finished! Great work.',
                            icon: '/favicon.ico'
                        });
                    }
                } catch (_) {}
            }

            try {
                const raw = localStorage.getItem(key);
                if (!raw) return;
                const st = JSON.parse(raw);
                if (!st || !st.isRunning || !st.endTimeMs) return;

                // Timer has expired while on another page
                if (Date.now() >= st.endTimeMs) {
                    // Mark as finished in localStorage
                    st.isRunning = false;
                    st.mode = 'idle';
                    localStorage.setItem(key, JSON.stringify(st));

                    tryPlayAlarm();
                    fireNotification();
                    showToast();
                }
            } catch (_) {}
        })();

        // ── Clear timer state on logout ──────────────────────────────────
        (function () {
            const uid = '@Html.Raw(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")';
            if (!uid) return;
            const key = 'focusSessionState_' + uid;
            document.querySelectorAll('form').forEach(function (form) {
                if (form.action && form.action.toLowerCase().includes('logout')) {
                    form.addEventListener('submit', function () {
                        try { localStorage.removeItem(key); } catch (_) {}
                    });
                }
            });
        })();
    </script>
</body>
</html>
