<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyTracker</title>
    <link rel="icon" type="image/svg+xml" href="/trophy.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1e1b4b" />
    <meta name="msapplication-TileColor" content="#1e1b4b" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#197fe6",
                        "background-light": "#f6f7f8",
                        "background-dark": "#111921",
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px"},
                },
            },
        }
    </script>
</head>
<body class="bg-background-light dark:bg-background-dark min-h-screen text-slate-900 dark:text-slate-100 flex flex-col overflow-x-hidden">
    @await Html.PartialAsync("_TailwindTierSafelist")
    <!-- Top Navigation -->
    @{
        var profilePictureUrl = ViewBag.ProfilePictureUrl as string;
        var userName = ViewBag.UserName as string ?? "U";
    }
    <header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
            <!-- Top bar -->
            <div class="h-16 flex items-center justify-between">
                <!-- Left: Logo -->
                <div class="flex items-center gap-2 min-w-0">
                    <a asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-2">
                        <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-primary/10 text-primary">
                            <span class="material-symbols-outlined text-[22px]">school</span>
                    </div>
                        <span class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white whitespace-nowrap">
                            StudyTracker
                        </span>
                </a>
            </div>

                <!-- Desktop Nav -->
                <nav class="hidden md:flex items-center gap-4 lg:gap-6 ml-6 flex-1">
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary dark:hover:text-primary transition-colors">
                    Dashboard
                </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index"
                           class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/5 px-3 py-1.5 text-xs font-medium text-primary hover:bg-primary/10 transition-colors">
                            <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
                            <span>Admin Panel</span>
                        </a>
                    }
                </nav>

                <!-- Right: Notifications, Theme, User / Logout (desktop) -->
                <div class="hidden md:flex items-center gap-3 whitespace-nowrap">
                    <button id="themeToggle"
                            class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                            type="button">
                        <span id="themeToggleIcon" class="material-symbols-outlined text-[18px]">dark_mode</span>
                    </button>
                    <div class="relative">
                        <button id="notificationBell" type="button"
                                class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors relative">
                            <span class="material-symbols-outlined text-[20px]">notifications</span>
                            <span id="notificationBadge" class="hidden absolute -top-1 -right-0.5 min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-bold flex items-center justify-center"></span>
                        </button>
                        <div id="notificationDropdown"
                             class="hidden absolute right-0 mt-2 w-[min(80vw,20rem)] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-lg overflow-hidden z-40">
                            <div class="px-4 py-2 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Notifications</span>
                                <button id="notificationMarkAll" type="button"
                                        class="text-[11px] text-primary hover:text-primary/80 font-semibold">
                                    Mark all as read
                                </button>
                            </div>
                            <div id="notificationList" class="max-h-80 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800">
                                <div class="px-4 py-6 text-center text-xs text-slate-400 dark:text-slate-500">
                                    Loading...
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@ViewBag.UserName</p>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                @:Super Admin
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                @:Admin
                            }
                            else
                            {
                                @:Student
                            }
                        </p>
                    </div>

                    <a asp-controller="Profile" asp-action="Index"
                       class="shrink-0 w-9 h-9 rounded-full overflow-hidden ring-2 ring-white dark:ring-slate-900 bg-slate-200 dark:bg-slate-700 hover:ring-primary transition">
                        @if (!string.IsNullOrWhiteSpace(profilePictureUrl))
                        {
                            <img src="@profilePictureUrl" alt="@userName"
                                 class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-sm font-semibold text-slate-600 dark:text-slate-300">
                                @userName.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="ml-1">
                        <button type="submit"
                                class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-red-600 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                            Logout
                        </button>
                    </form>
                </div>

                <!-- Mobile: Action buttons + Hamburger -->
                <div class="md:hidden flex items-center gap-1.5">
                    <!-- Mobile notification bell -->
                    <div class="relative">
                        <button id="notificationBellMobile" type="button"
                                class="inline-flex items-center justify-center w-9 h-9 rounded-full text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors relative"
                                aria-label="Notifications">
                            <span class="material-symbols-outlined text-[22px]">notifications</span>
                            <span id="notificationBadgeMobile" class="hidden absolute -top-0.5 -right-0.5 min-w-[16px] h-[16px] px-0.5 rounded-full bg-red-500 text-white text-[9px] font-bold flex items-center justify-center"></span>
                        </button>
                        <div id="notificationDropdownMobile"
                             class="hidden absolute right-0 mt-2 w-[min(80vw,20rem)] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-xl overflow-hidden z-50">
                            <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Notifications</span>
                                <button id="notificationMarkAllMobile" type="button"
                                        class="text-[11px] text-primary hover:text-primary/80 font-semibold">
                                    Mark all read
                                </button>
                            </div>
                            <div id="notificationListMobile" class="max-h-72 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800">
                                <div class="px-4 py-6 text-center text-xs text-slate-400 dark:text-slate-500">Loading...</div>
                            </div>
                        </div>
                    </div>
                    <!-- Mobile theme toggle -->
                    <button id="themeToggleMobile" type="button"
                            class="inline-flex items-center justify-center w-9 h-9 rounded-full text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                            aria-label="Toggle theme">
                        <span id="themeToggleIconMobile" class="material-symbols-outlined text-[20px]">dark_mode</span>
                    </button>
                    <!-- Hamburger -->
                    <button type="button"
                            id="mobile-nav-toggle"
                            class="inline-flex items-center justify-center w-9 h-9 rounded-full text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                            aria-label="Open navigation">
                        <span class="material-symbols-outlined text-[24px]">menu</span>
                    </button>
                </div>
            </div>

            <!-- Mobile dropdown -->
            <div id="mobile-nav-panel"
                 class="hidden md:hidden absolute inset-x-0 top-16 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 shadow-lg z-40">
                <!-- User info row -->
                <div class="px-3 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center gap-3">
                    <a asp-controller="Profile" asp-action="Index"
                       class="shrink-0 w-10 h-10 rounded-full overflow-hidden ring-2 ring-white dark:ring-slate-900 bg-slate-200 dark:bg-slate-700 hover:ring-primary transition">
                        @if (!string.IsNullOrWhiteSpace(profilePictureUrl))
                        {
                            <img src="@profilePictureUrl" alt="@userName" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-sm font-semibold text-slate-600 dark:text-slate-300">
                                @userName.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </a>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">@ViewBag.UserName</p>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                            @(User.IsInRole("SuperAdmin") ? "Super Admin" : User.IsInRole("Admin") ? "Admin" : "Student")
                        </p>
                    </div>
                </div>
                <div class="pb-3 pt-2 space-y-0.5 px-2">
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 active:bg-slate-100 dark:active:bg-slate-800 transition-colors">
                        <span class="inline-flex items-center gap-3">
                            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800">
                                <span class="material-symbols-outlined text-[16px] text-slate-500 dark:text-slate-400">dashboard</span>
                            </span>
                            <span>Dashboard</span>
                        </span>
                        <span class="material-symbols-outlined text-[16px] text-slate-400">chevron_right</span>
                    </a>

                    <a asp-controller="Target" asp-action="WeeklyProgress"
                       class="flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 active:bg-slate-100 dark:active:bg-slate-800 transition-colors">
                        <span class="inline-flex items-center gap-3">
                            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-primary/10">
                                <span class="material-symbols-outlined text-[16px] text-primary">analytics</span>
                            </span>
                            <span>Daily Progress</span>
                        </span>
                        <span class="material-symbols-outlined text-[16px] text-slate-400">chevron_right</span>
                    </a>

                    <a asp-controller="Todo" asp-action="Index"
                       class="flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 active:bg-slate-100 dark:active:bg-slate-800 transition-colors">
                        <span class="inline-flex items-center gap-3">
                            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-900/20">
                                <span class="material-symbols-outlined text-[16px] text-emerald-600 dark:text-emerald-400">checklist</span>
                            </span>
                            <span>Today's Tasks</span>
                        </span>
                        <span class="material-symbols-outlined text-[16px] text-slate-400">chevron_right</span>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index"
                           class="flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 active:bg-slate-100 dark:active:bg-slate-800 transition-colors">
                            <span class="inline-flex items-center gap-3">
                                <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-primary/10">
                                    <span class="material-symbols-outlined text-[16px] text-primary">admin_panel_settings</span>
                                </span>
                                <span>Admin Panel</span>
                            </span>
                            <span class="material-symbols-outlined text-[16px] text-slate-400">chevron_right</span>
                        </a>
                    }

                    <a asp-controller="Profile" asp-action="Index"
                       class="flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 active:bg-slate-100 dark:active:bg-slate-800 transition-colors">
                        <span class="inline-flex items-center gap-3">
                            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800">
                                <span class="material-symbols-outlined text-[16px] text-slate-500 dark:text-slate-400">person</span>
                            </span>
                            <span>Profile</span>
                        </span>
                        <span class="material-symbols-outlined text-[16px] text-slate-400">chevron_right</span>
                    </a>

                    <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit"
                                class="w-full flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 active:bg-red-50 dark:active:bg-red-900/20 transition-colors">
                            <span class="inline-flex items-center gap-3">
                                <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-red-50 dark:bg-red-900/20">
                                    <span class="material-symbols-outlined text-[16px] text-red-500">logout</span>
                                </span>
                                <span>Logout</span>
                            </span>
                            <span class="material-symbols-outlined text-[16px] text-red-400">chevron_right</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <script>
            (function () {
                const toggleButton = document.getElementById('mobile-nav-toggle');
                const panel = document.getElementById('mobile-nav-panel');

                if (!toggleButton || !panel) return;

                function toggleMenu() {
                    panel.classList.toggle('hidden');
                }

                toggleButton.addEventListener('click', function (e) {
                    e.stopPropagation();
                    toggleMenu();
                });

                document.addEventListener('click', function (e) {
                    if (!panel.classList.contains('hidden') &&
                        !panel.contains(e.target) &&
                        !toggleButton.contains(e.target)) {
                        panel.classList.add('hidden');
                    }
                });
            })();
        </script>
    </header>
    
    <!-- Main Content -->
    <main class="flex-1 w-full">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
                <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-400 px-4 py-3 rounded-lg mb-4">
                    @TempData["SuccessMessage"]
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
                <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-400 px-4 py-3 rounded-lg mb-4">
                    @TempData["ErrorMessage"]
                </div>
            </div>
        }
        @RenderBody()
    </main>

    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration
    @{
        var telegramUrl = Configuration["AdminContact:TelegramUrl"];
        var whatsappUrl = Configuration["AdminContact:WhatsAppUrl"];
        var githubUrl = Configuration["AdminContact:GitHubUrl"] ?? "https://github.com/NourEldeenMahmoud";
        var discordInviteUrl = Configuration["Community:DiscordInviteUrl"]?.Trim();
        var communityBugReportUrl = Configuration["Community:BugReportUrl"]?.Trim();
        var isAuth = User.Identity?.IsAuthenticated == true;
        var hasContact = !string.IsNullOrEmpty(telegramUrl) || !string.IsNullOrEmpty(whatsappUrl) || !string.IsNullOrEmpty(githubUrl)
            || (isAuth && (!string.IsNullOrEmpty(discordInviteUrl) || !string.IsNullOrEmpty(communityBugReportUrl)))
            || isAuth;
    }
    @if (hasContact)
    {
        <div class="fixed bottom-5 right-4 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-2" style="padding-bottom: env(safe-area-inset-bottom)">
            <div id="contactMenu" class="hidden flex flex-col items-end gap-2 mb-2">
                @if (isAuth)
                {
                    @if (!string.IsNullOrEmpty(discordInviteUrl))
                    {
                        <a href="@discordInviteUrl" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-2 pl-3 pr-4 py-2 rounded-xl bg-[#5865F2] text-white text-sm font-semibold shadow-lg hover:bg-[#4752C4] transition-colors whitespace-nowrap">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                            Join our Discord server
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(communityBugReportUrl))
                    {
                        <a href="@communityBugReportUrl" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-2 pl-3 pr-4 py-2 rounded-xl bg-rose-600 text-white text-sm font-semibold shadow-lg hover:bg-rose-700 transition-colors whitespace-nowrap">
                            <span class="material-symbols-outlined text-[18px] shrink-0">bug_report</span>
                            Report a bug
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Community" asp-action="Index"
                           class="inline-flex items-center gap-2 pl-3 pr-4 py-2 rounded-xl bg-rose-600 text-white text-sm font-semibold shadow-lg hover:bg-rose-700 transition-colors whitespace-nowrap">
                            <span class="material-symbols-outlined text-[18px] shrink-0">bug_report</span>
                            Report a bug
                        </a>
                    }
                }
                @if (!string.IsNullOrEmpty(githubUrl))
                {
                    <a href="@githubUrl" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-2 pl-3 pr-4 py-2 rounded-xl bg-slate-900 dark:bg-slate-700 text-white text-sm font-semibold shadow-lg hover:bg-slate-700 dark:hover:bg-slate-600 transition-colors whitespace-nowrap">
                        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                        GitHub
                    </a>
                }
                @if (!string.IsNullOrEmpty(telegramUrl))
                {
                    <a href="@telegramUrl" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-2 pl-3 pr-4 py-2 rounded-xl bg-[#0088cc] text-white text-sm font-semibold shadow-lg hover:bg-[#006da4] transition-colors whitespace-nowrap">
                        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
