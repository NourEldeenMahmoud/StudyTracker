@model StudyTracker.Models.ViewModels.AddSessionViewModel
@{
    ViewData["Title"] = "Add Study Session";
    Layout = "_UserLayout";
}

<main class="flex-grow flex justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col w-full max-w-[800px]">
        <!-- Page Header -->
        <div class="mb-8">
            <div class="flex flex-col gap-2">
                <h1 class="text-slate-900 dark:text-white text-3xl sm:text-4xl font-black leading-tight tracking-tight">Log Study Time</h1>
                <p class="text-slate-500 dark:text-slate-400 text-base sm:text-lg font-normal">Record your focused hours and keep the momentum going.</p>
            </div>
        </div>
        
        <!-- Form Container -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 lg:p-10 shadow-sm border border-slate-100 dark:border-slate-800">
            <form asp-action="Add" method="post" class="flex flex-col gap-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
                
                <!-- Date Input -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium" asp-for="Date">Date</label>
                    <div class="relative group">
                        <input asp-for="Date" class="w-full h-14 pl-4 pr-10 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-base" />
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined">calendar_today</span>
                        </div>
                        <span asp-validation-for="Date" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>
                
                <!-- Duration Inputs -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium">Duration</label>
                    <div class="flex gap-4">
                        <div class="relative flex-1 group">
                            <input asp-for="Hours" class="w-full h-14 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-base" min="0" max="16" placeholder="0" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-500 uppercase tracking-wider group-focus-within:text-primary transition-colors">Hrs</span>
                            <span asp-validation-for="Hours" class="text-red-500 text-xs mt-1"></span>
                        </div>
                        <div class="relative flex-1 group">
                            <input asp-for="Minutes" class="w-full h-14 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-base" max="59" min="0" placeholder="00" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-500 uppercase tracking-wider group-focus-within:text-primary transition-colors">Min</span>
                            <span asp-validation-for="Minutes" class="text-red-500 text-xs mt-1"></span>
                        </div>
                    </div>
                </div>
                
                <!-- Notes Input -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium" asp-for="Notes">Notes</label>
                    <div class="relative group">
                        <textarea asp-for="Notes" required minlength="1" class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-base resize-none" placeholder="Describe what you studied (e.g. topics, chapters, exercises)..." rows="4"></textarea>
                        <div class="absolute right-4 top-4 text-slate-400 group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined">edit_note</span>
                        </div>
                        <span asp-validation-for="Notes" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>
                
                <!-- Actions -->
                <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center sm:justify-end gap-3 mt-4 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <a asp-controller="Dashboard" asp-action="Index" class="flex items-center justify-center px-6 py-3 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white font-medium transition-colors text-sm border border-slate-200 dark:border-slate-700 sm:border-0">
                        Cancel
                    </a>
                    <button type="submit" class="group relative flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-primary hover:bg-blue-600 text-white font-bold text-sm shadow-lg shadow-blue-500/30 transition-all hover:shadow-blue-500/40 hover:-translate-y-0.5 active:translate-y-0 active:scale-95">
                        <span class="material-symbols-outlined text-[20px]">check_circle</span>
                        Save Session
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function() {
            const form = document.querySelector('main form[method="post"]');
            if (!form) return;
            form.addEventListener('submit', function(e) {
                const hoursInput = form.querySelector('input[name="Hours"]');
                const minutesInput = form.querySelector('input[name="Minutes"]');
                const hours = parseInt(hoursInput?.value) || 0;
                const minutes = parseInt(minutesInput?.value) || 0;
                const totalMinutes = hours * 60 + minutes;
                if (totalMinutes > 16 * 60) {
                    e.preventDefault();
                    let errEl = form.querySelector('.session-duration-error');
                    if (!errEl) {
                        errEl = document.createElement('div');
                        errEl.className = 'session-duration-error text-red-500 text-sm bg-red-50 dark:bg-red-900/20 px-4 py-3 rounded-lg border border-red-200 dark:border-red-800 mb-4';
                        errEl.setAttribute('role', 'alert');
                        form.insertBefore(errEl, form.firstChild);
                    }
                    errEl.textContent = 'Session duration cannot exceed 16 hours.';
                    errEl.hidden = false;
                    (hoursInput || form).focus();
                    return false;
                }
                form.querySelector('.session-duration-error')?.remove();
            });
        })();
    </script>
}
