@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
    var stats = ViewBag.Stats as StudyTracker.Models.ViewModels.AdminDashboardStatsViewModel;
}

<!-- Header -->
<header class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Dashboard Overview</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-1">Welcome back, here's what's happening with your students today.</p>
    </div>
</header>

<!-- Stats Cards Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
    <!-- Total Students -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col gap-4 group hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between">
            <div class="p-3 bg-blue-50 dark:bg-blue-900/20 text-primary rounded-xl">
                <span class="material-symbols-outlined">groups</span>
            </div>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Students</p>
            <h3 class="text-3xl font-bold text-slate-900 dark:text-white mt-1">@stats?.TotalStudents</h3>
        </div>
    </div>
    
    <!-- Active Sessions -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col gap-4 group hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between">
            <div class="p-3 bg-indigo-50 dark:bg-indigo-900/20 text-indigo-500 rounded-xl">
                <span class="material-symbols-outlined">network_check</span>
            </div>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Active Sessions Today</p>
            <h3 class="text-3xl font-bold text-slate-900 dark:text-white mt-1">@stats?.ActiveSessionsToday</h3>
        </div>
    </div>
    
    <!-- Total Hours -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col gap-4 group hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between">
            <div class="p-3 bg-amber-50 dark:bg-amber-900/20 text-amber-500 rounded-xl">
                <span class="material-symbols-outlined">schedule</span>
            </div>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Hours Logged</p>
            <h3 class="text-3xl font-bold text-slate-900 dark:text-white mt-1">@(stats?.TotalHoursLogged.ToString("F0") ?? "0")h</h3>
        </div>
    </div>
    
    <!-- Top User -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col gap-4 group hover:shadow-md transition-shadow relative overflow-hidden">
        <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary/5 rounded-full blur-2xl"></div>
        <div class="flex items-start justify-between relative z-10">
            <div class="p-3 bg-purple-50 dark:bg-purple-900/20 text-purple-500 rounded-xl">
                <span class="material-symbols-outlined">emoji_events</span>
            </div>
            <span class="text-xs font-medium text-purple-600 bg-purple-50 dark:bg-purple-900/20 px-2 py-1 rounded-full">
                Weekly MVP
            </span>
        </div>
        <div class="relative z-10">
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Top User (Weekly)</p>
            <h3 class="text-3xl font-bold text-slate-900 dark:text-white mt-1">@(stats?.TopUserWeeklyName ?? "N/A")</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@(stats?.TopUserWeeklyHours.ToString("F0") ?? "0")h</p>
        </div>
    </div>
</div>

<!-- Weekly Top 5 Table -->
<div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col">
    <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex flex-wrap justify-between items-center gap-4">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Weekly Top 5 Students</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider font-semibold">
                    <th class="px-6 py-4 rounded-tl-lg">Rank</th>
                    <th class="px-6 py-4">Student Name</th>
                    <th class="px-6 py-4">Hours Logged</th>
                    <th class="px-6 py-4 rounded-tr-lg text-right">Sessions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var entry in stats?.WeeklyTop5 ?? new List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel>())
                {
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="w-8 h-8 rounded-full @(entry.Rank == 1 ? "bg-amber-100 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400" : "bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300") flex items-center justify-center font-bold text-sm shadow-sm border border-slate-200">
                                @entry.Rank
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300 font-semibold text-sm">
                                    @entry.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <p class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">@entry.FullName</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-900 dark:text-white">@((int)entry.TotalHours)h</span>
                                <div class="w-16 h-1.5 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden">
                                    <div class="h-full bg-primary rounded-full" style="width: @(Math.Min(entry.TotalHours / (stats?.TopUserWeeklyHours ?? 1) * 100, 100))%"></div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <span class="text-slate-600 dark:text-slate-300 font-medium">@entry.SessionsCount</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
