@{
    ViewData["Title"] = "Session Management";
    Layout = "_AdminLayout";
    var paged = ViewBag.PagedSessions as StudyTracker.Models.ViewModels.PagedResult<StudyTracker.Models.ViewModels.AdminSessionViewModel>
        ?? new StudyTracker.Models.ViewModels.PagedResult<StudyTracker.Models.ViewModels.AdminSessionViewModel>();
    var sessions = paged.Items;
    var users = ViewBag.Users as List<StudyTracker.Models.ViewModels.AdminUserViewModel> ?? new List<StudyTracker.Models.ViewModels.AdminUserViewModel>();
    var selectedUserId = ViewBag.SelectedUserId as string;
    var startDate = ViewBag.StartDate as DateOnly?;
    var endDate = ViewBag.EndDate as DateOnly?;

    // Build a query-string helper that preserves filters across page links
    string PageUrl(int p)
    {
        var qs = new System.Text.StringBuilder("?");
        if (!string.IsNullOrEmpty(selectedUserId)) qs.Append($"userId={Uri.EscapeDataString(selectedUserId)}&");
        if (startDate.HasValue) qs.Append($"startDate={startDate.Value:yyyy-MM-dd}&");
        if (endDate.HasValue) qs.Append($"endDate={endDate.Value:yyyy-MM-dd}&");
        qs.Append($"page={p}");
        return qs.ToString();
    }

    int firstItem = paged.TotalCount == 0 ? 0 : (paged.Page - 1) * paged.PageSize + 1;
    int lastItem  = Math.Min(paged.Page * paged.PageSize, paged.TotalCount);
}

<!-- Header -->
<header class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Session Management</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-1">View and manage all study sessions.</p>
    </div>
    <div class="flex flex-wrap gap-3">
        <form asp-controller="Admin"
              asp-action="ResetCurrentWeekLeaderboard"
              method="post"
              id="reset-week-leaderboard-form">
            @Html.AntiForgeryToken()
            <button type="button"
                    onclick="confirmResetLeaderboard()"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-red-200 dark:border-red-700 text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/40 text-sm font-medium transition-colors">
                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                <span>Reset This Week Leaderboard</span>
            </button>
        </form>
    </div>
</header>

<!-- Filter Form -->
<div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
    <form method="get" id="sessions-filter-form" class="grid grid-cols-1 md:grid-cols-4 gap-4">

        @{
            var selectedUserName = users.FirstOrDefault(u => u.Id == selectedUserId)?.FullName;
        }
        <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">User</label>
            <input type="hidden" name="userId" id="userId-value" value="@(selectedUserId ?? "")" />
            <div class="relative" id="user-picker">
                <div class="relative">
                    <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-slate-400">
                        <span class="material-symbols-outlined text-[18px]">search</span>
                    </span>
                    <input type="text"
                           id="user-search"
                           placeholder="Search users…"
                           autocomplete="off"
                           value="@(selectedUserName ?? "")"
                           class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white pl-9 pr-8 py-2 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                    <button type="button"
                            id="user-clear"
                            class="absolute inset-y-0 right-2 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 @(string.IsNullOrEmpty(selectedUserId) ? "hidden" : "")"
                            tabindex="-1">
                        <span class="material-symbols-outlined text-[16px]">close</span>
                    </button>
                </div>
                <ul id="user-dropdown"
                    class="absolute z-20 mt-1 w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg shadow-lg max-h-56 overflow-y-auto hidden">
                    <li data-value="" data-label="All Users"
                        class="user-option flex items-center gap-2 px-4 py-2.5 text-sm cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400">
                        <span class="material-symbols-outlined text-[16px]">group</span>
                        All Users
                    </li>
                    @foreach (var user in users)
                    {
                        <li data-value="@user.Id" data-label="@user.FullName"
                            class="user-option flex items-center gap-2 px-4 py-2.5 text-sm cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-900 dark:text-slate-100 @(selectedUserId == user.Id ? "bg-primary/5 dark:bg-primary/10 font-medium" : "")">
                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-semibold flex-shrink-0">
                                @user.FullName.Substring(0, 1).ToUpper()
                            </span>
                            @user.FullName
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Start Date</label>
            <input type="date" name="startDate" value="@(startDate?.ToString("yyyy-MM-dd"))" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white px-4 py-2 focus:border-primary focus:ring-primary focus:ring-1" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">End Date</label>
            <input type="date" name="endDate" value="@(endDate?.ToString("yyyy-MM-dd"))" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white px-4 py-2 focus:border-primary focus:ring-primary focus:ring-1" />
        </div>
        <div class="flex items-end gap-2">
            <button type="submit" class="flex-1 px-6 py-2 bg-primary hover:bg-primary/90 text-white rounded-lg font-medium transition-colors">
                Filter
            </button>
            @if (!string.IsNullOrEmpty(selectedUserId) || startDate.HasValue || endDate.HasValue)
            {
                <a href="/Admin/Sessions" class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" title="Clear filters">
                    <span class="material-symbols-outlined text-[18px]">filter_alt_off</span>
                </a>
            }
        </div>
    </form>
</div>

<!-- Sessions Table -->
<div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col">
    <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">All Sessions (@paged.TotalCount)</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider font-semibold">
                    <th class="px-6 py-4">User</th>
                    <th class="px-6 py-4">Study date</th>
                    <th class="px-6 py-4">Duration</th>
                    <th class="px-6 py-4">Notes</th>
                    <th class="px-6 py-4 text-right">Logged at (Cairo)</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var session in sessions)
                {
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
                        <td class="px-6 py-4">
                            <span class="font-medium text-slate-900 dark:text-white">@session.UserName</span>
                        </td>
                        <td class="px-6 py-4 text-slate-600 dark:text-slate-300">@session.Date.ToString("MMM dd, yyyy")</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">
                                @session.FormattedDuration
                            </span>
                        </td>
                        <td class="px-6 py-4 text-slate-600 dark:text-slate-300">@(session.Notes ?? "-")</td>
                        <td class="px-6 py-4 text-right text-slate-600 dark:text-slate-300">@TimeZoneHelper.ToCairo(session.CreatedAt).ToString("MMM dd, yyyy HH:mm")</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-controller="Sessions" asp-action="Edit" asp-route-id="@session.Id" class="px-3 py-1.5 text-xs font-medium text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors">
                                    Edit
                                </a>
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <form asp-controller="Sessions" asp-action="Delete" asp-route-id="@session.Id" method="post" class="inline delete-session-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" onclick="confirmDeleteSession(this)" class="px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[16px]">lock</span>
                                            <span>Delete</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Pagination *@
    @if (paged.TotalPages > 1)
    {
        <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3">

            <p class="text-sm text-slate-500 dark:text-slate-400">
                Showing <span class="font-medium text-slate-700 dark:text-slate-200">@firstItem</span>–<span class="font-medium text-slate-700 dark:text-slate-200">@lastItem</span>
                of <span class="font-medium text-slate-700 dark:text-slate-200">@paged.TotalCount</span> sessions
            </p>

            <nav class="flex items-center gap-1" aria-label="Pagination">

                @* Previous *@
                @if (paged.HasPreviousPage)
                {
                    <a href="@PageUrl(paged.Page - 1)"
                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </a>
                }
                else
                {
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-100 dark:border-slate-800 text-slate-300 dark:text-slate-600 cursor-not-allowed">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </span>
                }

                @* Page numbers *@
                @{
                    int start = Math.Max(1, paged.Page - 2);
                    int end   = Math.Min(paged.TotalPages, paged.Page + 2);
                }

                @if (start > 1)
                {
                    <a href="@PageUrl(1)" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">1</a>
                    @if (start > 2)
                    {
                        <span class="inline-flex items-center justify-center w-8 h-8 text-sm text-slate-400 dark:text-slate-500">…</span>
                    }
                }

                @for (int p = start; p <= end; p++)
                {
                    if (p == paged.Page)
                    {
                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary text-white text-sm font-semibold">@p</span>
                    }
                    else
                    {
                        <a href="@PageUrl(p)" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">@p</a>
                    }
                }

                @if (end < paged.TotalPages)
                {
                    @if (end < paged.TotalPages - 1)
                    {
                        <span class="inline-flex items-center justify-center w-8 h-8 text-sm text-slate-400 dark:text-slate-500">…</span>
                    }
                    <a href="@PageUrl(paged.TotalPages)" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">@paged.TotalPages</a>
                }

                @* Next *@
                @if (paged.HasNextPage)
                {
                    <a href="@PageUrl(paged.Page + 1)"
                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </a>
                }
                else
                {
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-100 dark:border-slate-800 text-slate-300 dark:text-slate-600 cursor-not-allowed">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </span>
                }

            </nav>
        </div>
    }

</div>

@section Scripts {
    <script>
        // ── Searchable user picker ──────────────────────────────────────────────
        (function () {
            const search    = document.getElementById('user-search');
            const hidden    = document.getElementById('userId-value');
            const dropdown  = document.getElementById('user-dropdown');
            const clearBtn  = document.getElementById('user-clear');
            const options   = Array.from(dropdown.querySelectorAll('.user-option'));

            function openDropdown() {
                dropdown.classList.remove('hidden');
            }

            function closeDropdown() {
                dropdown.classList.add('hidden');
            }

            function selectOption(value, label) {
                hidden.value  = value;
                search.value  = value ? label : '';
                search.placeholder = value ? '' : 'Search users\u2026';
                clearBtn.classList.toggle('hidden', !value);
                closeDropdown();
                // Highlight the active option
                options.forEach(o => {
                    const active = o.dataset.value === value;
                    o.classList.toggle('bg-primary/5',  active);
                    o.classList.toggle('dark:bg-primary/10', active);
                    o.classList.toggle('font-medium', active);
                });
            }

            function filterOptions(query) {
                const q = query.toLowerCase();
                options.forEach(o => {
                    const match = o.dataset.label.toLowerCase().includes(q);
                    o.classList.toggle('hidden', !match);
                });
            }

            // Open on focus / input
            search.addEventListener('focus', () => {
                filterOptions(search.value);
                openDropdown();
            });

            search.addEventListener('input', () => {
                // While typing, clear the hidden value so a stale selection isn't kept
                hidden.value = '';
                clearBtn.classList.add('hidden');
                filterOptions(search.value);
                openDropdown();
            });

            // Pick an item
            options.forEach(o => {
                o.addEventListener('mousedown', e => {
                    e.preventDefault(); // keep focus on search input
                    selectOption(o.dataset.value, o.dataset.label);
                });
            });

            // Clear button
            clearBtn.addEventListener('click', () => {
                selectOption('', '');
                search.focus();
                filterOptions('');
                openDropdown();
            });

            // Close when clicking outside
            document.addEventListener('click', e => {
                if (!document.getElementById('user-picker').contains(e.target)) {
                    closeDropdown();
                    // If user typed but didn't pick, revert to the committed value
                    const committedLabel = options.find(o => o.dataset.value === hidden.value)?.dataset.label ?? '';
                    search.value = committedLabel;
                }
            });

            // Keyboard navigation
            search.addEventListener('keydown', e => {
                const visible = options.filter(o => !o.classList.contains('hidden'));
                const focused = dropdown.querySelector('.user-option.keyboard-focus');
                let idx = visible.indexOf(focused);

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    openDropdown();
                    if (focused) focused.classList.remove('keyboard-focus', 'bg-slate-100', 'dark:bg-slate-700');
                    idx = Math.min(idx + 1, visible.length - 1);
                    if (idx < 0) idx = 0;
                    visible[idx]?.classList.add('keyboard-focus', 'bg-slate-100', 'dark:bg-slate-700');
                    visible[idx]?.scrollIntoView({ block: 'nearest' });
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (focused) focused.classList.remove('keyboard-focus', 'bg-slate-100', 'dark:bg-slate-700');
                    idx = Math.max(idx - 1, 0);
                    visible[idx]?.classList.add('keyboard-focus', 'bg-slate-100', 'dark:bg-slate-700');
                    visible[idx]?.scrollIntoView({ block: 'nearest' });
                } else if (e.key === 'Enter') {
                    if (focused && !dropdown.classList.contains('hidden')) {
                        e.preventDefault();
                        selectOption(focused.dataset.value, focused.dataset.label);
                    }
                } else if (e.key === 'Escape') {
                    closeDropdown();
                }
            });
        })();

        // ── Confirm dialogs ─────────────────────────────────────────────────────
        async function confirmDeleteSession(button) {
            const confirmed = await showConfirm('Are you sure you want to delete this session?', 'Delete Session');
            if (confirmed) {
                const form = button.closest('form');
                form.submit();
            }
        }

        async function confirmResetLeaderboard() {
            const confirmed = await showConfirm(
                'This will delete ALL study sessions for the current week for all users. Are you sure?',
                'Reset Weekly Leaderboard'
            );
            if (confirmed) {
                const form = document.getElementById('reset-week-leaderboard-form');
                if (form) {
                    form.submit();
                }
            }
        }
    </script>
}
