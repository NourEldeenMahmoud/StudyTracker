@{
    ViewData["Title"] = "Session Management";
    Layout = "_AdminLayout";
    var sessions = ViewBag.Sessions as List<StudyTracker.Models.ViewModels.AdminSessionViewModel> ?? new List<StudyTracker.Models.ViewModels.AdminSessionViewModel>();
    var users = ViewBag.Users as List<StudyTracker.Models.ViewModels.AdminUserViewModel> ?? new List<StudyTracker.Models.ViewModels.AdminUserViewModel>();
    var selectedUserId = ViewBag.SelectedUserId as string;
    var startDate = ViewBag.StartDate as DateOnly?;
    var endDate = ViewBag.EndDate as DateOnly?;
}

<!-- Header -->
<header class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Session Management</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-1">View and manage all study sessions.</p>
    </div>
</header>

<!-- Filter Form -->
<div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
    <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">User</label>
            <select name="userId" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white px-4 py-2 focus:border-primary focus:ring-primary focus:ring-1">
                <option value="">All Users</option>
                @foreach (var user in users)
                {
                    <option value="@user.Id" selected="@(selectedUserId == user.Id)">@user.FullName</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Start Date</label>
            <input type="date" name="startDate" value="@(startDate?.ToString("yyyy-MM-dd"))" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white px-4 py-2 focus:border-primary focus:ring-primary focus:ring-1" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">End Date</label>
            <input type="date" name="endDate" value="@(endDate?.ToString("yyyy-MM-dd"))" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white px-4 py-2 focus:border-primary focus:ring-primary focus:ring-1" />
        </div>
        <div class="flex items-end">
            <button type="submit" class="w-full px-6 py-2 bg-primary hover:bg-primary/90 text-white rounded-lg font-medium transition-colors">
                Filter
            </button>
        </div>
    </form>
</div>

<!-- Sessions Table -->
<div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col">
    <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">All Sessions (@sessions.Count)</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider font-semibold">
                    <th class="px-6 py-4">User</th>
                    <th class="px-6 py-4">Date</th>
                    <th class="px-6 py-4">Duration</th>
                    <th class="px-6 py-4">Notes</th>
                    <th class="px-6 py-4 text-right">Created</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var session in sessions)
                {
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
                        <td class="px-6 py-4">
                            <span class="font-medium text-slate-900 dark:text-white">@session.UserName</span>
                        </td>
                        <td class="px-6 py-4 text-slate-600 dark:text-slate-300">@session.Date.ToString("MMM dd, yyyy")</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">
                                @session.FormattedDuration
                            </span>
                        </td>
                        <td class="px-6 py-4 text-slate-600 dark:text-slate-300">@(session.Notes ?? "-")</td>
                        <td class="px-6 py-4 text-right text-slate-600 dark:text-slate-300">@session.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-controller="Sessions" asp-action="Edit" asp-route-id="@session.Id" class="px-3 py-1.5 text-xs font-medium text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors">
                                    Edit
                                </a>
                                <form asp-controller="Sessions" asp-action="Delete" asp-route-id="@session.Id" method="post" class="inline delete-session-form">
                                    @Html.AntiForgeryToken()
                                    <button type="button" onclick="confirmDeleteSession(this)" class="px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function confirmDeleteSession(button) {
            const confirmed = await showConfirm('Are you sure you want to delete this session?', 'Delete Session');
            if (confirmed) {
                const form = button.closest('form');
                form.submit();
            }
        }
    </script>
}
