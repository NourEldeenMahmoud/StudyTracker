                        class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="">— Select a student —</option>
                    @foreach (var s in summaries.Where(s => s.Badges.Any()))
                    {
                        <option value="@s.UserId">@s.FullName (@s.Email)</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Badge to revoke</label>
                <select name="badgeKey" id="revokeBadgeSelect"
                        class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="">— Select a badge —</option>
                </select>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="button" onclick="document.getElementById('revokeModal').classList.add('hidden')"
                        class="flex-1 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">Cancel</button>
                <button type="submit"
                        class="flex-1 py-2.5 rounded-xl bg-red-600 text-white text-sm font-semibold hover:bg-red-700 transition-colors">Revoke Badge</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const userBadgeData = {
    @foreach (var s in summaries)
    {
        <text>
    "@s.UserId": [
            @foreach (var b in s.Badges)
            {
                var resolved = ResolveBadge(b.BadgeKey);
                var rName = resolved.Name;
                var rIsCustom = resolved.IsCustom;
                <text>{ key: "@b.BadgeKey", name: "@Html.Raw(rName.Replace("\"","\\\""))"@(rIsCustom ? ", custom: true" : "") },</text>
            }
        ],
        </text>
    }
};

function openAssign(userId, userName) {
    document.getElementById('assignUserSelect').value = userId;
    document.getElementById('assignModal').classList.remove('hidden');
}

function openAssignCustom(badgeId, badgeName) {
    document.getElementById('assignCustomBadgeId').value = badgeId;
    document.getElementById('assignCustomBadgeName').textContent = badgeName;
    document.getElementById('assignCustomModal').classList.remove('hidden');
}

function openEditSystemBadge(button) {
    const data = button.dataset;
    document.getElementById('editSystemBadgeKey').value = data.key || '';
    document.getElementById('editSystemBadgeKeyDisplay').textContent = data.key || '';
    document.getElementById('editSystemBadgeName').value = data.name || '';
    document.getElementById('editSystemBadgeDescription').value = data.description || '';
    document.getElementById('editSystemBadgeIcon').value = data.icon || '';
    const colorSelect = document.getElementById('editSystemBadgeColor');
    if (colorSelect && data.color) {
        colorSelect.value = data.color;
    }
    document.getElementById('editSystemBadgeModal').classList.remove('hidden');
}

function openEditCustom(button) {
    const data = button.dataset;
    document.getElementById('editBadgeId').value = data.id || '';
    document.getElementById('editBadgeName').value = data.name || '';
    document.getElementById('editBadgeDescription').value = data.description || '';
    document.getElementById('editBadgeIcon').value = data.icon || '';
    document.getElementById('editBadgeAdminNote').value = data.adminnote || '';

    const colorSelect = document.getElementById('editBadgeColor');
    if (colorSelect && data.color) {
        colorSelect.value = data.color;
    }

    document.getElementById('editCustomModal').classList.remove('hidden');
}

function openRevoke(userId, userName) {
    document.getElementById('revokeUserSelect').value = userId;
    populateRevokeBadges(userId);
    document.getElementById('revokeModal').classList.remove('hidden');
}

function populateRevokeBadges(userId) {
    const sel = document.getElementById('revokeBadgeSelect');
    sel.innerHTML = '<option value="">— Select a badge —</option>';
    (userBadgeData[userId] || []).forEach(b => {
        const opt = document.createElement('option');
        opt.value = b.key;
        opt.textContent = (b.custom ? '★ ' : '') + b.name;
        sel.appendChild(opt);
    });
}

// ── Icon type toggle ─────────────────────────────────────────────────
let currentIconType = 'symbol';

function setIconType(type) {
    currentIconType = type;
    const types = ['symbol', 'emoji', 'upload'];
    const btns  = {
        symbol: document.getElementById('iconTypeSymbol'),
        emoji:  document.getElementById('iconTypeEmoji'),
        upload: document.getElementById('iconTypeUpload'),
    };
    const pickers = {
        symbol: document.getElementById('symbolPicker'),
        emoji:  document.getElementById('emojiPicker'),
        upload: document.getElementById('uploadPicker'),
    };
    const iconInput   = document.getElementById('customIconInput');
    const fileInput   = document.getElementById('iconFileInput');

    types.forEach(t => {
        const active = t === type;
        pickers[t].classList.toggle('hidden', !active);
        btns[t].classList.toggle('border-primary', active);
        btns[t].classList.toggle('bg-primary/10', active);
        btns[t].classList.toggle('text-primary', active);
        btns[t].classList.toggle('border-slate-200', !active);
        btns[t].classList.toggle('dark:border-slate-700', !active);
        btns[t].classList.toggle('text-slate-500', !active);
    });

    if (type === 'symbol') {
        iconInput.value = document.getElementById('iconPreview').textContent.trim() || 'star';
        fileInput.value = '';
    } else if (type === 'emoji') {
        const emoji = document.getElementById('emojiInput').value || '⭐';
        iconInput.value = emoji;
        fileInput.value = '';
    } else {
        // upload mode — icon will come from file; clear the text icon field
        iconInput.value = '';
    }
}

function syncIconPreview(val) {
    document.getElementById('iconPreview').textContent = val || 'star';
    document.getElementById('customIconInput').value = val || 'star';
}

function setSymbol(sym) {
    document.getElementById('customIconInput').value = sym;
    document.getElementById('iconPreview').textContent = sym;
}

function setEmoji(em) {
    const cleaned = em.trim();
    document.getElementById('emojiInput').value = cleaned;
    document.getElementById('emojiPreview').textContent = cleaned || '⭐';
    document.getElementById('customIconInput').value = cleaned || '⭐';
}

// ── Upload icon helpers ──────────────────────────────────────────────
function previewUploadedIcon(input) {
    const file = input.files[0];
    if (!file) return;
    const wrap    = document.getElementById('uploadPreviewWrap');
    const img     = document.getElementById('uploadPreview');
    const nameEl  = document.getElementById('uploadFileName');
    const reader  = new FileReader();
    reader.onload = e => {
        img.src = e.target.result;
        nameEl.textContent = file.name;
        wrap.classList.remove('hidden');
        document.getElementById('uploadDropZone').classList.add('border-primary');
    };
    reader.readAsDataURL(file);
    // clear text icon so only the file is submitted
    document.getElementById('customIconInput').value = '';
}

function clearUpload() {
    document.getElementById('iconFileInput').value = '';
    document.getElementById('uploadPreviewWrap').classList.add('hidden');
    document.getElementById('uploadDropZone').classList.remove('border-primary');
    document.getElementById('uploadPreview').src = '';
}

// ── Hover tooltip for badges (admin) ────────────────────────────────
let badgeHoverTooltip = null;

function ensureBadgeHoverTooltip() {
    if (badgeHoverTooltip) return badgeHoverTooltip;
    const el = document.createElement('div');
    el.id = 'badge-hover-tooltip';
    el.className = 'fixed z-[260] hidden pointer-events-none';
    document.body.appendChild(el);
    badgeHoverTooltip = el;
    return el;
}

function showBadgeHoverTooltip(trigger) {
    const name = trigger.getAttribute('data-badge-name') || '';
    const desc = trigger.getAttribute('data-badge-description') || '';
    const icon = trigger.getAttribute('data-badge-icon') || '';
    const tooltip = ensureBadgeHoverTooltip();

    let iconHtml;
    if (icon && (icon.startsWith('/') || icon.startsWith('http'))) {
        iconHtml = `<img src="${icon}" class="inline-block w-7 h-7 object-cover rounded-full align-middle" />`;
    } else if (/^[a-z0-9_]+$/.test(icon)) {
        iconHtml = `<span class="material-symbols-outlined text-yellow-400 text-[24px]">${icon}</span>`;
    } else {
        iconHtml = `<span class="text-[22px] leading-none">${icon}</span>`;
    }

    tooltip.innerHTML = `
        <div class="rounded-2xl bg-slate-900/95 text-white shadow-2xl px-3 py-2 border border-slate-700 max-w-xs">
            <div class="flex items-start gap-2">
                <div class="shrink-0">
                    ${iconHtml}
                </div>
                <div class="min-w-0">
                    <p class="text-[13px] font-semibold leading-snug truncate">${name}</p>
                    ${desc ? `<p class="text-[11px] text-slate-200 leading-snug mt-0.5">${desc}</p>` : ''}
                </div>
            </div>
        </div>`;

    tooltip.style.opacity = '0';
    tooltip.classList.remove('hidden');

    const rect = trigger.getBoundingClientRect();
    const tipRect = tooltip.firstElementChild.getBoundingClientRect();
    const top = window.scrollY + rect.top - tipRect.height - 8;
    const left = window.scrollX + rect.left + rect.width / 2 - tipRect.width / 2;

    tooltip.style.top = `${Math.max(8, top)}px`;
    tooltip.style.left = `${Math.max(8, left)}px`;
    tooltip.style.opacity = '1';
}

function hideBadgeHoverTooltip() {
    if (!badgeHoverTooltip) return;
    badgeHoverTooltip.classList.add('hidden');
}

// ── Colour picker highlight ─────────────────────────────────────────
document.querySelectorAll('.color-radio').forEach(radio => {
    radio.addEventListener('change', () => {
        document.querySelectorAll('.color-swatch').forEach(sw => {
            sw.classList.remove('ring-2', 'ring-offset-1', 'ring-slate-400');
            sw.innerHTML = '';
        });
        const swatch = radio.nextElementSibling;
        swatch.classList.add('ring-2', 'ring-offset-1', 'ring-slate-400');
        swatch.innerHTML = '<span class="material-symbols-outlined text-white text-[16px]">check</span>';
    });
});

// Close modals on backdrop click
['assignModal','assignCustomModal','revokeModal','createCustomModal','editSystemBadgeModal'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
    });
});
</script>
}
