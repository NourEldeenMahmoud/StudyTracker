                                                                <div class="rounded-2xl bg-slate-900/95 text-white shadow-2xl px-3 py-2 border border-slate-700 max-w-xs">
                                                                    <div class="flex items-start gap-2">
                                                                        <div class="shrink-0">@Html.Raw(BadgeIcon(badge.Icon, "text-[24px]"))</div>
