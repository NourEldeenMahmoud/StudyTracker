@{
    ViewData["Title"] = "Dashboard";
    Layout = "_UserLayout";
    var targetProgress = ViewBag.TargetProgress as StudyTracker.Models.ViewModels.WeeklyTargetProgressViewModel;
    var weeklyLeaderboard = ViewBag.WeeklyLeaderboard as List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel> ?? new List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel>();
    var weekStart = ViewBag.WeekStart as DateOnly? ?? DateOnly.FromDateTime(DateTime.UtcNow);
    var weekEnd = ViewBag.WeekEnd as DateOnly? ?? weekStart.AddDays(6);
    var currentUserRank = ViewBag.CurrentUserRank as int? ?? 0;
    var currentUserHours = ViewBag.CurrentUserHours as decimal? ?? 0;
    var userName = ViewBag.UserName as string ?? "User";
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
    var dailyLeaderboard = ViewBag.DailyLeaderboard as List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel> ?? new List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel>();
    var todayDate = ViewBag.TodayDate as DateOnly? ?? DateOnly.FromDateTime(DateTime.UtcNow);
    
    var top3Daily = dailyLeaderboard.Take(3).ToList();
}

<main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Welcome Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Dashboard</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">Welcome back, @userName! You've been productive today.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" onclick="toggleDashboardPanel('logSessionPanel')" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-5 py-2.5 rounded-lg font-medium transition-colors shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Log Session</span>
            </button>
            <button type="button" onclick="toggleDashboardPanel('setupTargetPanel')" class="inline-flex items-center gap-2 bg-white text-primary border border-primary/30 hover:bg-primary/5 px-4 py-2.5 rounded-lg font-medium transition-colors shadow-md shadow-primary/10">
                <span class="material-symbols-outlined text-[20px]">target</span>
                <span>Setup Target</span>
            </button>
        </div>
    </div>

    <!-- Modals: Log Session + Setup Target -->
    <div id="logSessionPanel" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm transition-opacity duration-300" onclick="toggleDashboardPanel('logSessionPanel')">
        <div class="w-full max-w-xl mx-4 bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 shadow-xl border border-slate-100 dark:border-slate-800 transform transition-all duration-300 scale-95 opacity-0" id="logSessionPanelContent" onclick="event.stopPropagation()">
            <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Log Study Time</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-sm">Quickly record a new study session without leaving your dashboard.</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" onclick="toggleDashboardPanel('logSessionPanel')">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <form id="dashboardSessionForm" asp-controller="Sessions" asp-action="Add" method="post" asp-antiforgery="true" class="flex flex-col gap-6">
                <!-- Date - Hidden, always today -->
                <input type="hidden" name="Date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                
                <!-- Today's Date Display -->
                <div class="flex items-center gap-2 px-4 py-2 bg-primary/5 dark:bg-primary/10 rounded-lg border border-primary/20">
                    <span class="material-symbols-outlined text-primary text-[18px]">calendar_today</span>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Today: @DateTime.UtcNow.ToString("MMM dd, yyyy")</span>
                </div>

                <!-- Duration -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium">Duration</label>
                    <div class="flex gap-4">
                        <div class="relative flex-1 group">
                            <input id="hoursInput" name="Hours" type="number" min="0" max="16" value="0" placeholder="0" class="w-full h-12 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary focus:outline-none transition-all duration-200 text-sm" />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider group-focus-within:text-primary transition-colors duration-200">Hrs</span>
                        </div>
                        <div class="relative flex-1 group">
                            <input id="minutesInput" name="Minutes" type="number" min="0" max="59" value="0" placeholder="00" class="w-full h-12 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary focus:outline-none transition-all duration-200 text-sm" />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider group-focus-within:text-primary transition-colors duration-200">Min</span>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium" for="Dashboard_Notes">Notes <span class="text-slate-400 font-normal text-xs ml-1">(Optional)</span></label>
                    <div class="relative group">
                        <textarea id="Dashboard_Notes" name="Notes" rows="3" class="w-full p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-sm" placeholder="Add any details about your session, topics covered, or areas to review..."></textarea>
                        <div class="absolute right-3 top-3 text-slate-400 group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">edit_note</span>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <button type="button" class="px-4 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs sm:text-sm font-medium" onclick="toggleDashboardPanel('logSessionPanel')">
                        Cancel
                    </button>
                    <button type="submit" class="px-6 py-2 rounded-lg bg-primary hover:bg-blue-600 text-white font-semibold text-xs sm:text-sm shadow-md shadow-blue-500/30 transition-all">
                        Save Session
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="setupTargetPanel" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm transition-opacity duration-300" onclick="toggleDashboardPanel('setupTargetPanel')">
        <div class="w-full max-w-xl mx-4 bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 shadow-xl border border-slate-100 dark:border-slate-800 transform transition-all duration-300 scale-95 opacity-0" id="setupTargetPanelContent" onclick="event.stopPropagation()">
            <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Weekly Target Setup</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-sm">Set or update your daily study goal for this week.</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" onclick="toggleDashboardPanel('setupTargetPanel')">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <form asp-controller="Target" asp-action="Setup" method="post" class="flex flex-col gap-6">
                <!-- Daily Target Hours -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium" for="Dashboard_DailyTargetHours">Daily Target Hours</label>
                    <div class="relative group">
                        <input id="Dashboard_DailyTargetHours" name="DailyTargetHours" type="number" step="0.1" min="0.1" max="16" value="3.0" class="w-full h-12 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-sm" />
                        <div class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">schedule</span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Enter the number of hours you want to study each day (0.1 - 16 hours).</p>
                    </div>
                </div>

                <!-- Week Info (Read-only) -->
                <div class="flex items-center gap-2 px-4 py-2 bg-primary/5 dark:bg-primary/10 rounded-lg border border-primary/20">
                    <span class="material-symbols-outlined text-primary text-[18px]">calendar_today</span>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Week: @weekStart.ToString("MMM dd") - @weekStart.AddDays(6).ToString("MMM dd, yyyy")</span>
                </div>
                <input type="hidden" name="WeekStartDate" value="@weekStart.ToString("yyyy-MM-dd")" />

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <button type="button" class="px-4 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs sm:text-sm font-medium" onclick="toggleDashboardPanel('setupTargetPanel')">
                        Cancel
                    </button>
                    <button type="submit" class="px-6 py-2 rounded-lg bg-primary hover:bg-blue-600 text-white font-semibold text-xs sm:text-sm shadow-md shadow-blue-500/30 transition-all">
                        Save Target
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Middle Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Daily Goal Widget -->
        @if (targetProgress != null)
        {
            <div class="lg:col-span-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Daily Goal</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Keep up the momentum!</p>
                    </div>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold @(targetProgress.IsAchieved ? "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400" : "bg-primary/10 text-primary")">
                        @(targetProgress.IsAchieved ? "Achieved" : "On Track")
                    </span>
                </div>
                <div class="space-y-4">
                    <div class="flex justify-between items-end">
                        <span id="progressPercentage" class="text-4xl font-bold text-slate-900 dark:text-white transition-all duration-500 ease-out" data-value="@targetProgress.ProgressPercentage.ToString("F0")">@targetProgress.ProgressPercentage.ToString("F0")%</span>
                        <span id="todayDoneTime" class="text-sm font-medium text-slate-500 dark:text-slate-400 transition-all duration-500 ease-out" data-hours="@(targetProgress.TodayDoneMinutes / 60)" data-minutes="@(targetProgress.TodayDoneMinutes % 60)">@(targetProgress.TodayDoneMinutes / 60)h @(targetProgress.TodayDoneMinutes % 60)m / @(targetProgress.DailyTargetMinutes / 60)h</span>
                    </div>
                    <div class="h-3 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                        <div class="h-full bg-primary rounded-full transition-all duration-700 ease-out" style="width: @(Math.Min(targetProgress.ProgressPercentage, 100))%" data-progress="@(Math.Min(targetProgress.ProgressPercentage, 100))"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-400 dark:text-slate-500 pt-2">
                        <span>0h</span>
                        <span>@(targetProgress.DailyTargetMinutes / 60 / 2)h</span>
                        <span>Target: @(targetProgress.DailyTargetMinutes / 60)h</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="lg:col-span-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Daily Goal</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Set your weekly target to track your daily progress.</p>
                <a asp-controller="Target" asp-action="Setup" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-lg font-medium transition-colors">
                    <span class="material-symbols-outlined text-[18px]">target</span>
                    <span>Set Target</span>
                </a>
            </div>
        }
        
        <!-- Streak Widget -->
        @if (targetProgress != null)
        {
            var streakDays = targetProgress.StreakDays;
            var streakPercentage = streakDays > 0 ? Math.Min((streakDays / 30.0) * 100, 100) : 0;
            <div class="lg:col-span-1 bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 rounded-xl border-2 border-blue-200 dark:border-blue-800 shadow-lg shadow-blue-200/50 dark:shadow-blue-900/30 p-6 flex flex-col items-center justify-center relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-100/20 to-transparent dark:from-blue-800/10 opacity-50"></div>
                <div class="relative z-10 flex flex-col items-center w-full">
                    <div class="relative size-44 flex items-center justify-center mb-4">
                        <svg class="size-full -rotate-90" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                            <circle class="stroke-current text-blue-200 dark:text-blue-900/40" cx="18" cy="18" fill="none" r="16" stroke-width="3"></circle>
                            <circle class="stroke-current text-primary" cx="18" cy="18" fill="none" r="16" stroke-dasharray="100" stroke-dashoffset="@(100 - streakPercentage)" stroke-linecap="round" stroke-width="3"></circle>
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                            <span class="material-symbols-outlined text-5xl text-primary mb-0.5">local_fire_department</span>
                            <div class="text-center">
                                <div id="streakDays" class="text-4xl font-black text-slate-900 dark:text-white leading-none" data-streak="@streakDays">@streakDays</div>
                                <div class="text-[10px] font-bold text-primary uppercase tracking-wider mt-0.5">Days</div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center space-y-1">
                        <p class="text-lg font-bold text-slate-900 dark:text-white">Streak Active</p>
                        <p class="text-sm text-slate-600 dark:text-slate-300 font-medium">You’ve studied <span class="font-bold text-primary">@streakDays</span> day@(streakDays == 1 ? "" : "s") in a row. Keep going!</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="lg:col-span-1 bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-slate-800 dark:to-slate-900 rounded-xl border-2 border-blue-200 dark:border-slate-700 shadow-sm p-6 flex flex-col items-center justify-center">
                <div class="relative size-44 flex items-center justify-center mb-4">
                    <svg class="size-full -rotate-90" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                        <circle class="stroke-current text-blue-200 dark:text-slate-700" cx="18" cy="18" fill="none" r="16" stroke-width="3"></circle>
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="material-symbols-outlined text-5xl text-primary mb-0.5">local_fire_department</span>
                        <div class="text-center">
                            <div class="text-4xl font-black text-slate-900 dark:text-white leading-none">0</div>
                            <div class="text-[10px] font-bold text-primary uppercase tracking-wider mt-0.5">Days</div>
                        </div>
                    </div>
                </div>
                <div class="text-center space-y-1">
                    <p class="text-lg font-bold text-slate-900 dark:text-white">Start your streak</p>
                    <p class="text-sm text-slate-600 dark:text-slate-300 font-medium">Log a session today to get to <span class="font-bold text-primary">1 day</span>.</p>
                </div>
            </div>
        }
    </div>
    
    <!-- Daily Leaderboard Section -->
    <div class="flex flex-col gap-6 mt-8">
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-6">
            <div class="flex flex-col gap-2">
                <h2 class="text-slate-900 dark:text-white text-3xl md:text-4xl font-black tracking-tight">Daily Leaderboard 🏆</h2>
                <p class="text-slate-500 dark:text-slate-400 text-base">See who's studying the hardest today! Keep up the good work.</p>
            </div>
            <div class="flex items-center gap-2 bg-white dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm">
                <span class="material-symbols-outlined text-slate-400 text-[20px]">calendar_today</span>
                <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">@todayDate.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
        
        <!-- Podium Section -->
        @if (top3Daily.Any())
        {
            @if (top3Daily.Count == 1)
            {
                <!-- Single Winner -->
                var firstPlace = top3Daily[0];
                var firstHours = (int)firstPlace.TotalHours;
                var firstMins = (int)((firstPlace.TotalHours - firstHours) * 60);
                <div class="flex justify-center items-end mt-8">
                    <div class="w-full max-w-md relative flex flex-col items-center z-10">
                        <div class="absolute -top-10 animate-bounce">
                            <span class="text-4xl">👑</span>
                        </div>
                        <div class="w-full bg-white dark:bg-slate-800 rounded-2xl p-8 border-2 border-yellow-400/30 dark:border-yellow-500/30 shadow-lg shadow-yellow-500/10 relative overflow-hidden group hover:-translate-y-2 transition-transform duration-300">
                            <div class="absolute inset-0 bg-gradient-to-b from-yellow-50/50 to-transparent dark:from-yellow-900/10 opacity-50"></div>
                            <div class="absolute top-0 inset-x-0 h-1.5 bg-yellow-400"></div>
                            <div class="relative flex flex-col items-center gap-5">
                                <div class="relative">
                                    <div class="size-28 rounded-full border-4 border-yellow-400 dark:border-yellow-500 p-1 bg-white dark:bg-slate-800">
                                        @if (!string.IsNullOrEmpty(firstPlace.ProfilePictureUrl))
                                        {
                                            <img src="@firstPlace.ProfilePictureUrl" alt="@firstPlace.FullName" class="size-full rounded-full object-cover" 
                                                 onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <div class="size-full rounded-full bg-yellow-100 dark:bg-yellow-900/30 overflow-hidden flex items-center justify-center text-yellow-600 dark:text-yellow-400 font-semibold text-2xl" style="display: none;">
                                                @firstPlace.FullName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="size-full rounded-full bg-yellow-100 dark:bg-yellow-900/30 overflow-hidden flex items-center justify-center text-yellow-600 dark:text-yellow-400 font-semibold text-2xl">
                                                @firstPlace.FullName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                    </div>
                                    <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-xs font-bold border-2 border-white dark:border-slate-800 shadow-sm whitespace-nowrap">
                                        #1 Place
                                    </div>
                                </div>
                                <div class="text-center mt-2">
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white">@(firstPlace.IsCurrentUser ? "You" : firstPlace.FullName)</h3>
                                </div>
                                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-100 dark:border-yellow-800/30 rounded-xl px-6 py-3 w-full text-center">
                                    <span class="text-4xl font-black text-yellow-600 dark:text-yellow-400 block tracking-tight transition-all duration-500 ease-out" data-hours="@firstHours" data-minutes="@firstMins">@(firstHours)h @(firstMins)m</span>
                                    <span class="text-xs text-yellow-600/60 dark:text-yellow-400/60 uppercase tracking-wider font-bold">Study Time</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (top3Daily.Count == 2)
            {
                <!-- Two Winners - Pyramid Layout -->
                var firstPlace = top3Daily[0];
                var secondPlace = top3Daily[1];
                var firstHours = (int)firstPlace.TotalHours;
                var firstMins = (int)((firstPlace.TotalHours - firstHours) * 60);
                var secondHours = (int)secondPlace.TotalHours;
                var secondMins = (int)((secondPlace.TotalHours - secondHours) * 60);
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end mt-8">
                    <!-- 2nd Place -->
                    <div class="order-2 md:order-1 relative flex flex-col items-center">
                        <div class="absolute -top-12 z-20">
                            <span class="text-5xl drop-shadow-lg">🥈</span>
                        </div>
                        <div class="w-full bg-white dark:bg-slate-800 rounded-2xl p-6 border-2 border-slate-300 dark:border-slate-600 shadow-md shadow-slate-200/50 dark:shadow-slate-900/50 relative overflow-visible group hover:-translate-y-1 transition-transform duration-300 mt-4">
                            <div class="absolute inset-0 bg-gradient-to-b from-slate-50/30 to-transparent dark:from-slate-700/20 opacity-50"></div>
                            <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-slate-300 via-slate-400 to-slate-300"></div>
                            <div class="flex flex-col items-center gap-4">
                                <div class="relative">
                                    <div class="size-20 rounded-full border-4 border-slate-300 dark:border-slate-500 bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-700 dark:to-slate-800 overflow-hidden shadow-md">
                                        @if (!string.IsNullOrEmpty(secondPlace.ProfilePictureUrl))
                                        {
                                            <img src="@secondPlace.ProfilePictureUrl" alt="@secondPlace.FullName" class="size-full object-cover" 
                                                 onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <div class="size-full flex items-center justify-center text-slate-600 dark:text-slate-300 font-semibold text-lg" style="display: none;">
                                                @secondPlace.FullName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="size-full flex items-center justify-center text-slate-600 dark:text-slate-300 font-semibold text-lg">
                                                @secondPlace.FullName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                    </div>
                                    <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-gradient-to-br from-slate-300 to-slate-400 text-white px-3 py-1 rounded-full text-xs font-bold border-2 border-white dark:border-slate-800 shadow-md whitespace-nowrap">
                                        #2 Place
                                    </div>
                                </div>
                                <div class="text-center">
