        // ── Focus Session Timer (Web Worker + timestamp-based + background audio) ──
        (function () {
            const _uid = '@Html.Raw(currentUserId)';
            const STORAGE_KEY = 'focusSessionState' + (_uid ? '_' + _uid : '');
            let state = null;
            let worker = null;

            const focusHoursInput = document.getElementById('focusHoursInput');
            const focusMinutesInput = document.getElementById('focusMinutesInput');
            const breakHoursInput = document.getElementById('breakHoursInput');
            const breakMinutesInput = document.getElementById('breakMinutesInput');
            const notesInput = document.getElementById('focusNotesInput');
            const notesError = document.getElementById('focusNotesError');
            const finishedBanner = document.getElementById('focusFinishedBanner');
            const startBtn = document.getElementById('focusStartBtn');
            const pauseBtn = document.getElementById('focusPauseBtn');
            const resumeBtn = document.getElementById('focusResumeBtn');
            const endBtn = document.getElementById('focusEndBtn');
            const modeLabel = document.getElementById('focusSessionModeLabel');
            const timeLabel = document.getElementById('focusSessionTimeLabel');
            const statusPill = document.getElementById('focusSessionStatusPill');
            const studyCircle = document.getElementById('focusStudyCircle');
            const breakCircle = document.getElementById('focusBreakCircle');

            let _audioCtx = null;
            let _masterGain = null;

            // Audio buffers cache: decoded once, reused on every play
            const _audioBuffers = {};

            // ── Volume control ──────────────────────────────────────────
            const VOLUME_KEY = 'studytracker-alarm-volume';
            let _currentVolume = Math.min(100, Math.max(0, parseInt(localStorage.getItem(VOLUME_KEY) ?? '80')));
            let _prevVolume = _currentVolume > 0 ? _currentVolume : 80;

            function getAudioCtx() {
                try {
                    if (!_audioCtx) {
                        _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                        _masterGain = _audioCtx.createGain();
                        _masterGain.gain.value = _currentVolume / 100;
                        _masterGain.connect(_audioCtx.destination);
                    }
                    if (_audioCtx.state === 'suspended') _audioCtx.resume();
                    return _audioCtx;
                } catch (_) { return null; }
            }

            function getMasterGain() {
                getAudioCtx();
                return _masterGain;
            }

            // ── Volume slider init ──────────────────────────────────────
            (function initVolumeSlider() {
                const slider = document.getElementById('alarmVolumeSlider');
                const label  = document.getElementById('volumeLabel');
                const icon   = document.getElementById('volumeIcon');
                const btn    = document.getElementById('volumeToggleBtn');
                if (!slider || !label || !icon) return;

                function updateUI(vol) {
                    slider.value = vol;
                    label.textContent = vol + '%';
                    icon.textContent = vol === 0 ? 'volume_off' : vol < 50 ? 'volume_down' : 'volume_up';
                    if (_masterGain) _masterGain.gain.value = vol / 100;
                }

                updateUI(_currentVolume);

                slider.addEventListener('input', () => {
                    _currentVolume = parseInt(slider.value);
                    if (_currentVolume > 0) _prevVolume = _currentVolume;
                    localStorage.setItem(VOLUME_KEY, _currentVolume);
                    updateUI(_currentVolume);
                });

                if (btn) {
                    btn.addEventListener('click', () => {
                        if (_currentVolume > 0) {
                            _prevVolume = _currentVolume;
                            _currentVolume = 0;
                        } else {
                            _currentVolume = _prevVolume || 80;
                        }
                        localStorage.setItem(VOLUME_KEY, _currentVolume);
                        updateUI(_currentVolume);
                    });
                }
            })();

            async function loadAudioBuffer(url) {
                if (_audioBuffers[url]) return _audioBuffers[url];
                const ctx = getAudioCtx();
                if (!ctx) return null;
                try {
                    const resp = await fetch(url);
                    if (!resp.ok) return null;
                    const arrayBuf = await resp.arrayBuffer();
                    const decoded = await ctx.decodeAudioData(arrayBuf);
                    _audioBuffers[url] = decoded;
                    return decoded;
                } catch (_) { return null; }
            }

            // Pre-load both files as soon as possible (after first user interaction)
            function preloadSounds() {
                loadAudioBuffer('/alarm.mp3');
                loadAudioBuffer('/break.mp3');
            }

            function beep(ctx, freq, startAt, dur, vol) {
                const osc = ctx.createOscillator();
                const g = ctx.createGain();
                const dest = getMasterGain() || ctx.destination;
                osc.connect(g); g.connect(dest);
                osc.type = 'sine'; osc.frequency.value = freq;
                g.gain.setValueAtTime(0, ctx.currentTime + startAt);
                g.gain.linearRampToValueAtTime(vol, ctx.currentTime + startAt + 0.03);
                g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + startAt + dur);
                osc.start(ctx.currentTime + startAt);
                osc.stop(ctx.currentTime + startAt + dur + 0.05);
            }

            async function playSound(type) {
                if (_currentVolume === 0) return; // muted
                const url = type === 'break' ? '/break.mp3' : '/alarm.mp3';
                const ctx = getAudioCtx();

                // Try to play the real audio file via AudioContext (works in background tabs)
                if (ctx) {
                    try {
                        const buffer = await loadAudioBuffer(url);
                        if (buffer) {
                            if (ctx.state === 'suspended') await ctx.resume();
                            const src = ctx.createBufferSource();
                            src.buffer = buffer;
                            const dest = getMasterGain() || ctx.destination;
                            src.connect(dest);
                            src.start(0);
                            return;
                        }
                    } catch (_) {}

                    // Fallback: synthesized beep if file failed to load
                    try {
                        if (type === 'break') { beep(ctx, 520, 0, 0.25, 0.3); beep(ctx, 660, 0.3, 0.25, 0.3); }
                        else { beep(ctx, 440, 0, 0.3, 0.3); beep(ctx, 660, 0.35, 0.3, 0.3); beep(ctx, 880, 0.7, 0.4, 0.35); }
                        return;
                    } catch (_) {}
                }

                // Last resort: HTML Audio element
                try {
                    const a = new Audio(url);
                    a.volume = _currentVolume / 100;
                    a.play().catch(() => {});
                } catch (_) {}

                try {
                    if (Notification.permission === 'granted') {
                        new Notification('StudyTracker', { body: type === 'break' ? 'Time for a break!' : 'Focus session finished!', icon: '/trophy.svg' });
                    }
                } catch (_) {}
            }

            function requestNotifPermission() {
                try { if (Notification.permission === 'default') Notification.requestPermission(); } catch (_) {}
            }

            document.addEventListener('visibilitychange', function () {
                if (document.hidden) return;
                if (state && state.pendingSound) {
                    playSound(state.pendingSound);
                    state.pendingSound = null;
                    saveState();
                }
                if (finishedBanner && state && state.showFinishedBanner) {
                    finishedBanner.style.display = 'flex';
                    state.showFinishedBanner = false;
                    saveState();
                }
            });

            function loadState() {
                try { const r = localStorage.getItem(STORAGE_KEY); return r ? JSON.parse(r) : null; } catch { return null; }
            }
            function saveState() {
                if (!state) { localStorage.removeItem(STORAGE_KEY); return; }
                localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
            }
            function fmtTime(sec) {
                const s = Math.max(0, Math.floor(sec));
                return `${Math.floor(s/60).toString().padStart(2,'0')}:${(s%60).toString().padStart(2,'0')}`;
            }

            function recalcRemaining() {
                if (!state || !state.isRunning) return;
                const elapsed = (Date.now() - state.lastTickMs) / 1000;
                if (state.mode === 'focus') {
                    state.focusRemainingSeconds = Math.max(0, (state._savedFocusRemaining || state.focusRemainingSeconds) - elapsed);
                    if (state.focusRemainingSeconds <= 0) {
                        state.focusRemainingSeconds = 0;
                        if (state.breakTotalSeconds > 0 && state.breakRemainingSeconds > 0) {
                            state.mode = 'break';
                            state._savedFocusRemaining = 0;
                            state._savedBreakRemaining = state.breakRemainingSeconds;
                            state.lastTickMs = Date.now();
                            state.endTimeMs = Date.now() + state.breakRemainingSeconds * 1000;
                            playSound('break');
                        } else {
                            state.isRunning = false;
                            playSound('finish');
                            saveState(); updateStatusUi();
                            finishAndLog(true, true);
                            return;
                        }
                    }
                } else if (state.mode === 'break') {
                    state.breakRemainingSeconds = Math.max(0, (state._savedBreakRemaining || state.breakRemainingSeconds) - elapsed);
                    if (state.breakRemainingSeconds <= 0) {
                        state.breakRemainingSeconds = 0;
                        state.isRunning = false;
                        playSound('finish');
                        saveState(); updateStatusUi();
                        finishAndLog(true, true);
                        return;
                    }
                }
            }

            // Show/hide buttons via style.display directly — more reliable than
            // toggling the 'hidden' Tailwind class, which can be overridden by
            // other display utilities (e.g. inline-flex) depending on CSS order.
            function showBtn(btn) { if (btn) btn.style.display = ''; }
            function hideBtn(btn) { if (btn) btn.style.display = 'none'; }

            function updateStatusUi() {
                if (!state || state.mode === 'idle') {
                    statusPill.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span><span>Idle</span>';
                    if (modeLabel) modeLabel.textContent = 'Not started';
                    timeLabel.textContent = '00:00';
                    if (studyCircle) { studyCircle.style.transition='none'; studyCircle.style.strokeDasharray='0 100'; studyCircle.style.strokeDashoffset='0'; }
                    if (breakCircle) { breakCircle.style.transition='none'; breakCircle.style.strokeDasharray='0 100'; breakCircle.style.strokeDashoffset='0'; }
                    showBtn(startBtn); hideBtn(pauseBtn); hideBtn(resumeBtn); hideBtn(endBtn);
                    if (notesInput) notesInput.disabled = false;
                    if (focusHoursInput) focusHoursInput.disabled = false;
                    if (focusMinutesInput) focusMinutesInput.disabled = false;
                    if (breakHoursInput) breakHoursInput.disabled = false;
                    if (breakMinutesInput) breakMinutesInput.disabled = false;
                    return;
                }
                const isRunning = state.isRunning;
                const inFocus = state.mode === 'focus';
                const rF = state.focusRemainingSeconds || 0;
                const rB = state.breakRemainingSeconds || 0;
                const fT = state.focusTotalSeconds || 0;
                const bT = state.breakTotalSeconds || 0;
                const tS = fT + bT;

                statusPill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${isRunning ? 'bg-emerald-500' : 'bg-amber-500'}"></span><span>${inFocus ? 'Focusing' : 'On break'}${!isRunning ? ' (paused)' : ''}</span>`;
                if (modeLabel) modeLabel.textContent = inFocus ? 'Focusing' : 'On break';
                timeLabel.textContent = fmtTime(rF + rB);

                if (studyCircle && fT > 0) {
                    const rU = rF / tS * 100; const eU = ((fT - rF) + (bT - rB)) / tS * 100;
                    studyCircle.style.transition = 'stroke-dashoffset 0.6s cubic-bezier(0.4,0,0.2,1)';
                    studyCircle.style.strokeDasharray = `${rU} ${100 - rU}`;
                    studyCircle.style.strokeDashoffset = String(-eU);
                }
                if (breakCircle) {
                    const rU = bT > 0 ? rB / tS * 100 : 0;
                    breakCircle.style.transition = 'stroke-dashoffset 0.6s cubic-bezier(0.4,0,0.2,1)';
                    breakCircle.style.strokeDasharray = `${rU} ${100 - rU}`;
                    breakCircle.style.strokeDashoffset = String(rU - 100);
                }
                hideBtn(startBtn); showBtn(endBtn);
                if (isRunning) { showBtn(pauseBtn); hideBtn(resumeBtn); }
                else { hideBtn(pauseBtn); showBtn(resumeBtn); }
                if (notesInput) notesInput.disabled = true;
                if (focusHoursInput) focusHoursInput.disabled = true;
                if (focusMinutesInput) focusMinutesInput.disabled = true;
                if (breakHoursInput) breakHoursInput.disabled = true;
                if (breakMinutesInput) breakMinutesInput.disabled = true;
            }

            function onWorkerMsg(e) {
                if (!state || !state.isRunning) return;
                if (e.data.type === 'tick') {
                    recalcRemaining();
                    saveState();
                    updateStatusUi();
                } else if (e.data.type === 'done') {
                    recalcRemaining();
                }
            }

            function startWorker(durationMs) {
                if (worker) worker.terminate();
                try {
                    worker = new Worker('/js/timer-worker.js');
                    worker.onmessage = onWorkerMsg;
                    worker.postMessage({ cmd: 'start', durationMs });
                } catch (_) {
                    // Fallback: setInterval if Worker fails
                    worker = null;
                    setInterval(() => { if (state && state.isRunning) { recalcRemaining(); saveState(); updateStatusUi(); } }, 1000);
                }
            }

            function startNewSession() {
                const notes = (notesInput ? notesInput.value : '').trim();
                if (!notes) {
                    if (notesError) notesError.style.display = 'flex';
                    if (notesInput) notesInput.focus();
                    return;
                }
                if (notesError) notesError.style.display = 'none';
                if (finishedBanner) finishedBanner.style.display = 'none';

                getAudioCtx();
                preloadSounds();
                requestNotifPermission();

                const fH = parseInt(focusHoursInput.value) || 0;
                const fM = parseInt(focusMinutesInput.value) || 0;
                const bH = parseInt(breakHoursInput.value) || 0;
                const bM = parseInt(breakMinutesInput.value) || 0;
                if (fH < 0 || fM < 0 || bH < 0 || bM < 0) { showNotification('Time values cannot be negative.', 'warning'); return; }
                const focMin = fH * 60 + fM; const brkMin = bH * 60 + bM;
                if (focMin < 10) { showNotification('Focus time must be at least 10 minutes.', 'warning'); return; }
                if (brkMin > focMin * 0.3) { showNotification('Break time cannot exceed 30% of focus time.', 'warning'); return; }
                const fS = focMin * 60; const bS = brkMin * 60;

                state = { isRunning: true, started: true, mode: 'focus', notes: notes,
                    timerRunId: (crypto.randomUUID && crypto.randomUUID()) || (Date.now().toString(36) + Math.random().toString(36).slice(2)),
                    focusTotalSeconds: fS, breakTotalSeconds: bS,
                    focusRemainingSeconds: fS, breakRemainingSeconds: bS,
                    _savedFocusRemaining: fS, _savedBreakRemaining: bS,
                    lastTickMs: Date.now(),
                    endTimeMs: Date.now() + (fS + bS) * 1000 };
                saveState();
                startWorker((fS + bS) * 1000);
                updateStatusUi();
                showNotification('Focus session started. Stay focused!', 'info');
            }

            function pauseSession() {
                if (!state) return;
                recalcRemaining();
                state.isRunning = false;
                state._savedFocusRemaining = state.focusRemainingSeconds;
                state._savedBreakRemaining = state.breakRemainingSeconds;
                if (worker) worker.postMessage({ cmd: 'pause' });
                saveState(); updateStatusUi();
            }

            function resumeSession() {
                if (!state) return;
                state.isRunning = true; state.lastTickMs = Date.now();
                state._savedFocusRemaining = state.focusRemainingSeconds;
                state._savedBreakRemaining = state.breakRemainingSeconds;
                state.endTimeMs = Date.now() + (state.focusRemainingSeconds + state.breakRemainingSeconds) * 1000;
                saveState();
                const rem = (state.focusRemainingSeconds + state.breakRemainingSeconds) * 1000;
                if (worker) worker.postMessage({ cmd: 'resume' });
                else startWorker(rem);
                updateStatusUi();
            }

            function getDashboardAntiforgeryToken() {
                const input = document.querySelector('#dashboardSessionForm input[name="__RequestVerificationToken"]');
                return input ? input.value : '';
            }

            let focusLogInFlight = false;
            function cairoOrLocalYmd() {
                if (typeof window.__studyTrackerCairoToday === 'string' && window.__studyTrackerCairoToday.length >= 10)
                    return window.__studyTrackerCairoToday;
                const d = new Date();
                const y = d.getFullYear();
                const m = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${y}-${m}-${day}`;
            }
            async function logFocusSession(totalMinutes, breakMinutes, notes, timerRunId) {
                if (focusLogInFlight) return false;
                focusLogInFlight = true;
                try {
                    const hours = Math.floor(totalMinutes / 60); const minutes = totalMinutes % 60;
                    const fd = new FormData();
                    fd.append('Date', cairoOrLocalYmd());
                    fd.append('Hours', hours.toString()); fd.append('Minutes', minutes.toString());
                    fd.append('Notes', notes || `Focus session: ${hours}h ${minutes}m`);
                    fd.append('Source', 'timer');
                    if (timerRunId) fd.append('TimerRunId', timerRunId);
                    const token = getDashboardAntiforgeryToken();
                    const r = await fetch('/Sessions/Add', { method: 'POST', body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest', ...(token ? { 'RequestVerificationToken': token } : {}) } });
                    if (r.ok) {
                        const ct = r.headers.get('content-type') || '';
                        if (ct.includes('application/json')) { const j = await r.json(); if (!j.success) { showNotification(j.message || 'Could not log.', 'error'); return false; } }
                        showNotification('Focus session logged.', 'success');
                        await updateDashboardData();
                        if (window.refreshNotificationBadge) window.refreshNotificationBadge();
                        return true;
                    }
                    showNotification('Could not log focus session.', 'error'); return false;
                } catch (e) { console.error(e); showNotification('Could not log focus session.', 'error'); return false; }
                finally { focusLogInFlight = false; }
            }

            async function finishAndLog(includeBreak, soundAlreadyPlayed) {
                if (!state || !state.focusTotalSeconds) { resetState(); return; }
                const uF = Math.max(0, state.focusTotalSeconds - (state.focusRemainingSeconds || 0));
                const uB = Math.max(0, (state.breakTotalSeconds || 0) - (state.breakRemainingSeconds || 0));
                const bM = uB > 0 ? Math.round(uB / 60) : 0;
                const tM = includeBreak ? Math.max(1, Math.round((uF + uB) / 60)) : Math.max(1, Math.round(uF / 60));
                const notes = state.notes || '';

                if (tM < 10) {
                    if (!soundAlreadyPlayed) playSound('finish');
                    showNotification('Focus sessions shorter than 10 minutes are not logged.', 'info');
                    resetState(); return;
                }
                const ok = await logFocusSession(tM, bM, notes, state.timerRunId);
                if (ok) { if (!soundAlreadyPlayed) playSound('finish'); }
                if (document.hidden) { state = state || {}; state.showFinishedBanner = true; saveState(); }
                else if (finishedBanner) finishedBanner.style.display = 'flex';
                resetState();
            }

            function resetState() {
                state = { mode: 'idle' }; saveState();
                if (worker) { worker.terminate(); worker = null; }
                updateStatusUi();
                if (notesInput) notesInput.value = '';
            }

            function endSession() { finishAndLog(false, false); }

            if (startBtn) {
                startBtn.addEventListener('click', startNewSession);
                if (pauseBtn)  pauseBtn.addEventListener('click', pauseSession);
                if (resumeBtn) resumeBtn.addEventListener('click', resumeSession);
                if (endBtn)    endBtn.addEventListener('click', endSession);
                if (notesInput) notesInput.addEventListener('input', () => { if (notesError) notesError.style.display = 'none'; });

                state = loadState();
                if (!state || (state.mode !== 'focus' && state.mode !== 'break')) {
                    state = { mode: 'idle' }; saveState();
                } else {
                    if (notesInput && state.notes) notesInput.value = state.notes;
                    if (state.isRunning) {
                        recalcRemaining();
                        saveState();
                        const rem = ((state.focusRemainingSeconds || 0) + (state.breakRemainingSeconds || 0)) * 1000;
                        if (rem > 0) {
                            startWorker(rem);
                        } else {
                            // Session ended while page was closed.
                            // Reset UI to idle immediately (synchronously) so the page loads cleanly,
                            // then log the completed session in the background.
                            const snap = Object.assign({}, state);
                            state = { mode: 'idle' }; saveState();
                            if (notesInput) notesInput.value = '';
                            (async () => {
                                try {
                                    const uF = Math.max(0, (snap.focusTotalSeconds || 0) - (snap.focusRemainingSeconds || 0));
                                    const uB = Math.max(0, (snap.breakTotalSeconds || 0) - (snap.breakRemainingSeconds || 0));
                                    const tM = Math.max(1, Math.round((uF + uB) / 60));
                                    if (tM >= 10) {
                                        const ok = await logFocusSession(tM, 0, snap.notes || '', snap.timerRunId);
                                        if (ok) {
                                            if (finishedBanner) finishedBanner.style.display = 'flex';
                                            if (window.refreshNotificationBadge) window.refreshNotificationBadge();
                                        }
                                    }
                                } catch (_) {}
                            })();
                        }
                    }
                }
                updateStatusUi();
            }
        })();

    </script>
}
