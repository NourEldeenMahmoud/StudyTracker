@{
    ViewData["Title"] = "Dashboard";
    Layout = "_UserLayout";
    var targetProgress = ViewBag.TargetProgress as StudyTracker.Models.ViewModels.WeeklyTargetProgressViewModel;
    var weeklyLeaderboard = ViewBag.WeeklyLeaderboard as List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel> ?? new List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel>();
    var weekStart = ViewBag.WeekStart as DateOnly? ?? DateHelper.GetWeekStartDate(TimeZoneHelper.GetTodayInCairo());
    var weekEnd = ViewBag.WeekEnd as DateOnly? ?? weekStart.AddDays(6);
    var currentUserRank = ViewBag.CurrentUserRank as int? ?? 0;
    var currentUserHours = ViewBag.CurrentUserHours as decimal? ?? 0;
    var userName = ViewBag.UserName as string ?? "User";
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
    var dailyLeaderboard = ViewBag.DailyLeaderboard as List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel> ?? new List<StudyTracker.Models.ViewModels.LeaderboardEntryViewModel>();
    var todayDate = ViewBag.TodayDate as DateOnly? ?? TimeZoneHelper.GetTodayInCairo();
    var dashboardStreakDays = ViewBag.StreakDays as int? ?? 0;
    var top3Daily = dailyLeaderboard.Take(3).ToList();
}

@functions {
    /// Renders a badge icon: Material Symbols name, emoji/text, or uploaded image URL.
    IHtmlContent BadgeIcon(string icon, string sizeClass) {
        if ((icon ?? "").StartsWith("/") || (icon ?? "").StartsWith("http"))
            return new Microsoft.AspNetCore.Html.HtmlString($"<img src=\"{System.Net.WebUtility.HtmlEncode(icon)}\" class=\"inline-block w-6 h-6 object-cover rounded-full align-middle\" />");
        bool isMaterial = BadgeIconHelper.IsMaterialSymbolName(icon);
        string html = isMaterial
            ? $"<span class=\"material-symbols-outlined {sizeClass}\">{System.Net.WebUtility.HtmlEncode(icon)}</span>"
            : $"<span class=\"{sizeClass} leading-none\">{System.Net.WebUtility.HtmlEncode(icon)}</span>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}

<script>
    window.__studyTrackerCairoToday = '@todayDate.ToString("yyyy-MM-dd")';
</script>
<main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Welcome Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Dashboard</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">Welcome back, @userName! You've been productive today.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
            <button type="button" onclick="toggleDashboardPanel('logSessionPanel')" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white px-5 py-2.5 rounded-lg font-medium transition-colors shadow-lg shadow-primary/20 active:scale-95">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Log Session</span>
            </button>
            <a asp-controller="Target" asp-action="WeeklyProgress"
               class="inline-flex items-center justify-center gap-2 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 px-4 py-2.5 rounded-lg font-medium transition-colors shadow-sm active:scale-95">
                <span class="material-symbols-outlined text-[20px] text-primary">analytics</span>
                <span>Weekly Progress</span>
            </a>
            <a asp-controller="Sessions" asp-action="Index"
               class="inline-flex items-center justify-center gap-2 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 px-4 py-2.5 rounded-lg font-medium transition-colors shadow-sm active:scale-95">
                <span class="material-symbols-outlined text-[20px] text-primary">history</span>
                <span>Study History</span>
            </a>
        </div>
    </div>

    <!-- Modals: Log Session + Setup Target -->
    <div id="logSessionPanel" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm transition-opacity duration-300" onclick="toggleDashboardPanel('logSessionPanel')">
        <div class="w-full max-w-xl mx-4 bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 shadow-xl border border-slate-100 dark:border-slate-800 transform transition-all duration-300 scale-95 opacity-0" id="logSessionPanelContent" onclick="event.stopPropagation()">
            <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Log Study Time</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-sm">Quickly record a new study session without leaving your dashboard.</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" onclick="toggleDashboardPanel('logSessionPanel')">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <form id="dashboardSessionForm" asp-controller="Sessions" asp-action="Add" method="post" asp-antiforgery="true" class="flex flex-col gap-6">
                <input type="hidden" name="DashboardQuickLog" value="true" />
                <!-- Date - Hidden; server uses Cairo today when DashboardQuickLog is set (avoids stale value after midnight). -->
                <input type="hidden" name="Date" value="@todayDate.ToString("yyyy-MM-dd")" />
                
                <!-- Today's Date Display (Cairo) -->
                <div class="flex items-center gap-2 px-4 py-2 bg-primary/5 dark:bg-primary/10 rounded-lg border border-primary/20">
                    <span class="material-symbols-outlined text-primary text-[18px]">calendar_today</span>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Today: @todayDate.ToString("MMM dd, yyyy")</span>
                </div>

                <!-- Duration -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium">Duration</label>
                    <div class="flex gap-4">
                        <div class="relative flex-1 group">
                            <input id="hoursInput" name="Hours" type="number" min="0" max="16" value="0" placeholder="0" class="w-full h-12 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary focus:outline-none transition-all duration-200 text-sm" />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider group-focus-within:text-primary transition-colors duration-200">Hrs</span>
                        </div>
                        <div class="relative flex-1 group">
                            <input id="minutesInput" name="Minutes" type="number" min="0" max="59" value="0" placeholder="00" class="w-full h-12 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary focus:outline-none transition-all duration-200 text-sm" />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider group-focus-within:text-primary transition-colors duration-200">Min</span>
                        </div>
                    </div>
                </div>

                <!-- Notes (required) -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium" for="Dashboard_Notes">Notes</label>
                    <div class="relative group">
                        <textarea id="Dashboard_Notes" name="Notes" rows="3" required minlength="1" class="w-full p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-sm" placeholder="Describe what you studied (e.g. topics, chapters, exercises)..."></textarea>
                        <div class="absolute right-3 top-3 text-slate-400 group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">edit_note</span>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <button type="button" class="px-4 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs sm:text-sm font-medium" onclick="toggleDashboardPanel('logSessionPanel')">
                        Cancel
                    </button>
                    <button type="submit" class="px-6 py-2 rounded-lg bg-primary hover:bg-blue-600 text-white font-semibold text-xs sm:text-sm shadow-md shadow-blue-500/30 transition-all">
                        Save Session
                    </button>
                </div>
            </form>
        </div>
    </div>

    
    <!-- Focus Session + Streak Row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Focus Session Timer -->
        <div class="lg:col-span-2">
            <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="material-symbols-outlined text-[22px] text-primary">hourglass_top</span>
                            Focus Session
                        </h2>
                    </div>
                    <div id="focusSessionStatusPill" class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                        <span>Idle</span>
                    </div>
                </div>

                <!-- Required notes before starting -->
                <div class="mb-4">
                    <label for="focusNotesInput" class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1 block">What will you study? <span class="text-red-500">*</span></label>
                    <input id="focusNotesInput" type="text" maxlength="250" required placeholder="e.g. Math Chapter 5, Physics problems..."
                           class="w-full h-11 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm px-4 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary" />
                    <p id="focusNotesError" style="display:none" class="text-red-500 text-xs mt-1.5 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">error</span> Please describe what you'll study before starting.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:items-center">
                    <div class="space-y-3">
                        <div class="flex flex-col gap-1">
                            <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Focus time</label>
                            <div class="flex gap-2">
                                <div class="flex-1">
                                    <input id="focusHoursInput" type="number" min="0" max="23" value="0"
                                           class="w-full h-11 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm px-3 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary"
                                           placeholder="Hours" />
                                </div>
                                <div class="flex-1">
                                    <input id="focusMinutesInput" type="number" min="0" max="59" value="50"
                                           class="w-full h-11 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm px-3 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary"
                                           placeholder="Minutes" />
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total break time</label>
                            <div class="flex gap-2">
                                <div class="flex-1">
                                    <input id="breakHoursInput" type="number" min="0" max="23" value="0"
                                           class="w-full h-11 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm px-3 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary"
                                           placeholder="Hours" />
                                </div>
                                <div class="flex-1">
                                    <input id="breakMinutesInput" type="number" min="0" max="59" value="10"
                                           class="w-full h-11 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm px-3 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary"
                                           placeholder="Minutes" />
                                </div>
                            </div>
                            <p class="text-[11px] text-slate-400 mt-0.5">Break time cannot exceed 30% of total focus time.</p>
                        </div>
                    </div>

                    <div class="flex flex-col items-center justify-center gap-3">
                        
                        <div class="relative size-40 flex items-center justify-center">
                            <svg class="size-full -rotate-90" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                                <circle class="stroke-current text-slate-200 dark:text-slate-700" cx="18" cy="18" fill="none" r="16" stroke-width="3"></circle>
                                <circle id="focusStudyCircle" class="stroke-current text-primary" cx="18" cy="18" fill="none" r="16" stroke-dasharray="0 100" stroke-dashoffset="0" stroke-linecap="round" stroke-width="3"></circle>
                                <circle id="focusBreakCircle" class="stroke-current text-amber-400" cx="18" cy="18" fill="none" r="16" stroke-dasharray="0 100" stroke-dashoffset="0" stroke-linecap="round" stroke-width="3"></circle>
                            </svg>
                            <div class="absolute inset-0 flex flex-col items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[26px] text-primary">hourglass_top</span>
                                <p id="focusSessionTimeLabel" class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                                    00:00
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2 items-stretch">
                        <div class="flex gap-2">
                            <button id="focusStartBtn" type="button"
                                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-primary hover:bg-primary/90 text-white text-sm font-semibold shadow-sm shadow-primary/30 transition-colors">
                                <span class="material-symbols-outlined text-[18px]">play_arrow</span>
                                <span>Start</span>
                            </button>
                            <button id="focusPauseBtn" type="button" style="display:none"
                                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-sm font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                                <span class="material-symbols-outlined text-[18px]">pause</span>
                                <span>Pause</span>
                            </button>
                            <button id="focusResumeBtn" type="button" style="display:none"
                                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-primary hover:bg-primary/90 text-white text-sm font-semibold shadow-sm shadow-primary/30 transition-colors">
                                <span class="material-symbols-outlined text-[18px]">play_arrow</span>
                                <span>Resume</span>
                            </button>
                        </div>
                        <div class="flex gap-2">
                            <button id="focusEndBtn" type="button" style="display:none"
                                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-xs font-semibold hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors">
                                <span class="material-symbols-outlined text-[18px]">stop_circle</span>
                                <span>End session</span>
                            </button>
                        </div>
                        <!-- Alarm volume -->
                        <div class="flex items-center gap-2 pt-1">
                            <button type="button" id="volumeToggleBtn" class="shrink-0 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors" title="Toggle mute">
                                <span id="volumeIcon" class="material-symbols-outlined text-[18px]">volume_up</span>
                            </button>
                            <input type="range" id="alarmVolumeSlider"
                                   min="0" max="100" value="80"
                                   class="flex-1 h-1.5 rounded-full cursor-pointer accent-primary" />
                            <span id="volumeLabel" class="text-[11px] text-slate-400 dark:text-slate-500 w-7 text-right tabular-nums">80%</span>
                        </div>
                    </div>
                </div>
                <!-- Timer finished alert (shown when user returns to tab) -->
                <div id="focusFinishedBanner" style="display:none" class="mt-4 p-4 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-300 text-sm font-medium flex items-center gap-3 animate-pulse">
                    <span class="material-symbols-outlined text-[24px]">check_circle</span>
                    <span>Your focus session has finished! The session has been logged.</span>
                </div>
            </section>
        </div>

        <!-- Streak Widget (activity-based; always shown, independent of weekly target) -->
        @{
            var streakPercentage = dashboardStreakDays > 0 ? Math.Min((dashboardStreakDays / 30.0) * 100, 100) : 0;
        }
        @if (dashboardStreakDays > 0)
        {
            <div class="lg:col-span-1 bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 rounded-xl border-2 border-blue-200 dark:border-blue-800 shadow-lg shadow-blue-200/50 dark:shadow-blue-900/30 p-6 flex flex-col items-center justify-center relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-100/20 to-transparent dark:from-blue-800/10 opacity-50"></div>
                <div class="relative z-10 flex flex-col items-center w-full">
                    <div class="relative size-44 flex items-center justify-center mb-4">
                        <svg class="size-full -rotate-90" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                            <circle class="stroke-current text-blue-200 dark:text-blue-900/40" cx="18" cy="18" fill="none" r="16" stroke-width="3"></circle>
                            <circle class="stroke-current text-primary" cx="18" cy="18" fill="none" r="16" stroke-dasharray="100" stroke-dashoffset="@(100 - streakPercentage)" stroke-linecap="round" stroke-width="3"></circle>
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                            <span class="material-symbols-outlined text-5xl text-primary mb-0.5">local_fire_department</span>
                            <div class="text-center">
                                <div id="streakDays" class="text-4xl font-black text-slate-900 dark:text-white leading-none" data-streak="@dashboardStreakDays">@dashboardStreakDays</div>
                                <div class="text-[10px] font-bold text-primary uppercase tracking-wider mt-0.5">Days</div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center space-y-1">
                        <p class="text-lg font-bold text-slate-900 dark:text-white">Streak Active</p>
                        <p class="text-sm text-slate-600 dark:text-slate-300 font-medium">You've studied <span class="font-bold text-primary">@dashboardStreakDays</span> day@(dashboardStreakDays == 1 ? "" : "s") in a row. Keep going!</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="lg:col-span-1 bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-slate-800 dark:to-slate-900 rounded-xl border-2 border-blue-200 dark:border-slate-700 shadow-sm p-6 flex flex-col items-center justify-center">
                <div class="relative size-44 flex items-center justify-center mb-4">
                    <svg class="size-full -rotate-90" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg">
                        <circle class="stroke-current text-blue-200 dark:text-slate-700" cx="18" cy="18" fill="none" r="16" stroke-width="3"></circle>
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="material-symbols-outlined text-5xl text-primary mb-0.5">local_fire_department</span>
                        <div class="text-center">
                            <div class="text-4xl font-black text-slate-900 dark:text-white leading-none">0</div>
                            <div class="text-[10px] font-bold text-primary uppercase tracking-wider mt-0.5">Days</div>
                        </div>
                    </div>
                </div>
                <div class="text-center space-y-1">
                    <p class="text-lg font-bold text-slate-900 dark:text-white">Start your streak</p>
                    <p class="text-sm text-slate-600 dark:text-slate-300 font-medium">Log a session today to get to <span class="font-bold text-primary">1 day</span>.</p>
                </div>
            </div>
        }
    </div>
    
    <!-- Mobile quick link to Todo page -->
    <a asp-controller="Todo" asp-action="Index"
       class="md:hidden flex items-center justify-between bg-white dark:bg-slate-900 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm px-4 py-3.5 active:scale-95 transition-transform">
        <span class="inline-flex items-center gap-3">
            <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-900/20">
                <span class="material-symbols-outlined text-[18px] text-emerald-600 dark:text-emerald-400">checklist</span>
            </span>
            <span class="text-sm font-semibold text-slate-900 dark:text-white">Today's Tasks</span>
        </span>
        <span class="material-symbols-outlined text-[18px] text-slate-400">chevron_right</span>
    </a>

    <!-- ── Daily Todo List (desktop only — mobile has /Todo page) ── -->
    <div class="hidden md:block bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
        <div class="flex items-center gap-2 mb-5">
            <span class="material-symbols-outlined text-primary text-[22px]">checklist</span>
            <h2 class="text-base font-bold text-slate-900 dark:text-white">Today's Tasks</h2>
            <span id="todoCount" class="ml-auto text-xs text-slate-400 dark:text-slate-500"></span>
            <button id="todoClearBtn" onclick="todoClearAll()"
                    class="hidden items-center gap-1 text-xs text-red-500 hover:text-red-700 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 px-2.5 py-1 rounded-lg transition-colors ml-1">
                <span class="material-symbols-outlined text-[15px]">delete_sweep</span>
                <span>Clear all</span>
            </button>
        </div>

        <!-- Add new task -->
        <div class="flex gap-2 mb-5">
            <input id="todoInput" type="text" maxlength="500" placeholder="Add a task for today…"
                   class="flex-1 min-w-0 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-colors" />
            <button id="todoAddBtn" onclick="todoAdd()"
                    class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary/90 text-white text-sm font-medium px-4 py-2.5 rounded-lg transition-colors shadow-sm shadow-primary/20 shrink-0">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>Add</span>
            </button>
        </div>

        <!-- Task list -->
        <ul id="todoList" class="space-y-2">
            <!-- filled by JS -->
        </ul>

        <!-- Empty state -->
        <div id="todoEmpty" class="hidden flex-col items-center justify-center py-8 text-center gap-2">
            <span class="material-symbols-outlined text-slate-300 dark:text-slate-600 text-[40px]">task_alt</span>
