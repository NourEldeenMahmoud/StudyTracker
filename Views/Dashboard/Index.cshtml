@section Scripts {
    <script>
        function toggleDashboardPanel(panelId) {
            const panels = ["logSessionPanel", "setupTargetPanel"];
            panels.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                const content = document.getElementById(id + 'Content') || el.querySelector('.modal-content') || el.children[0];
                
                if (id === panelId) {
                    const isHidden = el.classList.contains("hidden");
                    if (isHidden) {
                        el.classList.remove("hidden");
                        // Trigger animation
                        setTimeout(() => {
                            if (content) {
                                content.classList.remove("scale-95", "opacity-0");
                                content.classList.add("scale-100", "opacity-100");
                            }
                        }, 10);
                        
                        // Reset form when opening
                        if (id === 'logSessionPanel') {
                            const form = document.getElementById('dashboardSessionForm');
                            if (form) {
                                form.reset();
                                // Set default values
                                const hoursInput = document.getElementById('hoursInput');
                                const minutesInput = document.getElementById('minutesInput');
                                if (hoursInput) hoursInput.value = '0';
                                if (minutesInput) minutesInput.value = '0';
                            }
                        }
                    } else {
                        // Animate out
                        if (content) {
                            content.classList.remove("scale-100", "opacity-100");
                            content.classList.add("scale-95", "opacity-0");
                        }
                        setTimeout(() => {
                            el.classList.add("hidden");
                        }, 300);
                    }
                } else {
                    // Animate out other panels
                    if (content) {
                        content.classList.remove("scale-100", "opacity-100");
                        content.classList.add("scale-95", "opacity-0");
                    }
                    setTimeout(() => {
                        el.classList.add("hidden");
                    }, 300);
                }
            });
        }
        
        // Clear default value (0) when user starts typing in Hours or Minutes
        document.addEventListener('DOMContentLoaded', function() {
            const hoursInput = document.getElementById('hoursInput');
            const minutesInput = document.getElementById('minutesInput');
            
            if (hoursInput) {
                // Clear on focus if value is 0
                hoursInput.addEventListener('focus', function() {
                    if (this.value === '0' || this.value === '') {
                        this.value = '';
                    }
                });
                
                // Restore 0 if empty on blur
                hoursInput.addEventListener('blur', function() {
                    if (this.value === '' || this.value === null) {
                        this.value = '0';
                    }
                });
                
                // Select all text on focus for easy replacement
                hoursInput.addEventListener('click', function() {
                    if (this.value === '0') {
                        this.select();
                    }
                });
            }
            
            if (minutesInput) {
                // Clear on focus if value is 0
                minutesInput.addEventListener('focus', function() {
                    if (this.value === '0' || this.value === '') {
                        this.value = '';
                    }
                });
                
                // Restore 0 if empty on blur
                minutesInput.addEventListener('blur', function() {
                    if (this.value === '' || this.value === null) {
                        this.value = '0';
                    }
                });
                
                // Select all text on focus for easy replacement
                minutesInput.addEventListener('click', function() {
                    if (this.value === '0') {
                        this.select();
                    }
                });
            }
        });
        
        // Handle dashboard session form submission via AJAX
        document.getElementById('dashboardSessionForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const form = e.target;
            const submitButton = form.querySelector('button[type="submit"]');
            const originalButtonText = submitButton.textContent;
            
            // Validate inputs before submission
            const hoursInput = form.querySelector('input[name="Hours"]');
            const minutesInput = form.querySelector('input[name="Minutes"]');
            
            // Ensure Hours and Minutes have default values if empty
            if (!hoursInput.value || hoursInput.value === '') {
                hoursInput.value = '0';
            }
            if (!minutesInput.value || minutesInput.value === '') {
                minutesInput.value = '0';
            }
            
            // Validate that at least one field has a value > 0
            const hours = parseInt(hoursInput.value) || 0;
            const minutes = parseInt(minutesInput.value) || 0;
            
            if (hours === 0 && minutes === 0) {
                showNotification('Please enter a duration (hours or minutes must be greater than 0).', 'warning');
                hoursInput.focus();
                return;
            }
            
            // Disable submit button
            submitButton.disabled = true;
            submitButton.textContent = 'Saving...';
            
            try {
                const formData = new FormData(form);
                
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                // Check response status
                if (response.ok) {
                    // Try to parse as JSON first
                    const contentType = response.headers.get('content-type') || '';
                    
                    if (contentType.includes('application/json')) {
                        const result = await response.json();
                        
                        if (result.success) {
                            // Close modal
                            toggleDashboardPanel('logSessionPanel');
                            
                            // Reset form
                            form.reset();
                            document.getElementById('hoursInput').value = '0';
                            document.getElementById('minutesInput').value = '0';
                            
                            // Show success message
                            showNotification('Session added successfully!', 'success');
                            
                            // Update dashboard data without reload
                            await updateDashboardData();
                            
                            submitButton.disabled = false;
                            submitButton.textContent = originalButtonText;
                        } else {
                            showNotification('Error: ' + (result.message || 'An error occurred'), 'error');
                            submitButton.disabled = false;
                            submitButton.textContent = originalButtonText;
                        }
                    } else {
                        // Handle HTML response (fallback)
                        const html = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        
                        const validationErrors = doc.querySelectorAll('.text-danger, .field-validation-error, .validation-summary-errors li');
                        let errorMessages = [];
                        validationErrors.forEach(err => {
                            const text = err.textContent?.trim();
                            if (text && !errorMessages.includes(text)) {
                                errorMessages.push(text);
                            }
                        });
                        
                        if (errorMessages.length > 0) {
                            showNotification('Error: ' + errorMessages.join('\n'), 'error');
                            submitButton.disabled = false;
                            submitButton.textContent = originalButtonText;
                        } else {
                            // Success - update data
                            toggleDashboardPanel('logSessionPanel');
                            form.reset();
                            document.getElementById('hoursInput').value = '0';
                            document.getElementById('minutesInput').value = '0';
                            showNotification('Session added successfully!', 'success');
                            await updateDashboardData();
                            submitButton.disabled = false;
                            submitButton.textContent = originalButtonText;
                        }
                    }
                } else {
                    // Handle error response
                    const html = await response.text();
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    const errorMessages = doc.querySelectorAll('.text-danger, .field-validation-error, .validation-summary-errors li');
                    let errorText = [];
                    errorMessages.forEach(err => {
                        const text = err.textContent?.trim();
                        if (text && !errorText.includes(text)) {
                            errorText.push(text);
                        }
                    });
                    
                    if (errorText.length > 0) {
                        showNotification('Error: ' + errorText.join('\n'), 'error');
                    } else {
                        showNotification('An error occurred. Please check your input and try again.', 'error');
                    }
                    
                    submitButton.disabled = false;
                    submitButton.textContent = originalButtonText;
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('An error occurred while saving the session. Please try again.', 'error');
                submitButton.disabled = false;
                submitButton.textContent = originalButtonText;
            }
        });
        
        // Function to update dashboard data without reload
        async function updateDashboardData() {
            try {
                const response = await fetch('/Dashboard/GetDashboardData', {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                if (!response.ok) {
                    console.error('Failed to fetch dashboard data');
                    return;
                }
                
                const data = await response.json();
                
                if (!data.success) {
                    console.error('Error fetching dashboard data:', data.message);
                    return;
                }
                
                // Update target progress
                if (data.targetProgress) {
                    updateTargetProgress(data.targetProgress);
                }
                
                // Update leaderboards
                if (data.dailyLeaderboard && data.dailyLeaderboard.length > 0) {
                    updateDailyLeaderboard(data.dailyLeaderboard);
                }
                
                if (data.weeklyLeaderboard && data.weeklyLeaderboard.length > 0) {
                    updateWeeklyLeaderboard(data.weeklyLeaderboard);
                }
                
                // Update current user stats
                updateCurrentUserStats(data.currentUserRank, data.currentUserHours);
                
            } catch (error) {
                console.error('Error updating dashboard:', error);
            }
        }
        
        // Update target progress widget
        function updateTargetProgress(progress) {
            // Update percentage
            const percentageEl = document.getElementById('progressPercentage');
            if (percentageEl) {
                const oldValue = parseFloat(percentageEl.getAttribute('data-value')) || 0;
                const newValue = parseFloat(progress.progressPercentage.toFixed(0));
                if (oldValue !== newValue) {
                    animateNumber(percentageEl, oldValue, newValue, '%');
                    percentageEl.setAttribute('data-value', newValue);
                }
            }
            
            // Update hours/minutes
            const hoursMinsEl = document.getElementById('todayDoneTime');
            if (hoursMinsEl) {
                const hours = Math.floor(progress.todayDoneMinutes / 60);
                const mins = progress.todayDoneMinutes % 60;
                const targetHours = Math.floor(progress.dailyTargetMinutes / 60);
                const oldHours = parseInt(hoursMinsEl.getAttribute('data-hours')) || 0;
                const oldMins = parseInt(hoursMinsEl.getAttribute('data-minutes')) || 0;
                
                if (hours !== oldHours || mins !== oldMins) {
                    animateTime(hoursMinsEl, oldHours, oldMins, hours, mins);
                    hoursMinsEl.setAttribute('data-hours', hours);
                    hoursMinsEl.setAttribute('data-minutes', mins);
                    // Update the target part
                    const currentText = hoursMinsEl.textContent;
                    if (currentText.includes('/')) {
                        const parts = currentText.split('/');
                        hoursMinsEl.textContent = `${hours}h ${mins}m / ${targetHours}h`;
                    }
                }
            }
            
            // Update progress bar
            const progressBar = document.querySelector('[data-progress]');
            if (progressBar) {
                const newWidth = Math.min(progress.progressPercentage, 100);
                const oldWidth = parseFloat(progressBar.getAttribute('data-progress')) || 0;
                if (Math.abs(newWidth - oldWidth) > 0.1) {
                    progressBar.style.transition = 'width 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
                    progressBar.style.width = newWidth + '%';
                    progressBar.setAttribute('data-progress', newWidth);
                }
            }
            
            // Update streak
            const streakEl = document.getElementById('streakDays');
            if (streakEl) {
                const oldStreak = parseInt(streakEl.getAttribute('data-streak')) || 0;
                if (progress.streakDays !== oldStreak) {
                    animateNumber(streakEl, oldStreak, progress.streakDays, '');
                    streakEl.setAttribute('data-streak', progress.streakDays);
                }
            }
        }
        
        // Update daily leaderboard
        function updateDailyLeaderboard(leaderboard) {
            // Update top 3 podium
            const top3 = leaderboard.slice(0, 3);
            top3.forEach((entry, index) => {
                const hours = Math.floor(entry.totalHours);
                const mins = Math.floor((entry.totalHours - hours) * 60);
                
                // Find and update the corresponding element
                const timeElements = document.querySelectorAll('[data-hours]');
                timeElements.forEach(el => {
                    const elHours = parseInt(el.getAttribute('data-hours')) || 0;
                    const elMins = parseInt(el.getAttribute('data-minutes')) || 0;
                    
                    // Check if this is the right entry (rough match)
                    if (Math.abs(elHours - hours) <= 1 && Math.abs(elMins - mins) <= 5) {
                        animateTime(el, elHours, elMins, hours, mins);
                    }
                });
            });
        }
        
        // Update weekly leaderboard table
        function updateWeeklyLeaderboard(leaderboard) {
            leaderboard.forEach(entry => {
                const hours = Math.floor(entry.totalHours);
                const mins = Math.floor((entry.totalHours - hours) * 60);
                
                // Find row by userId or name
                const rows = document.querySelectorAll('tbody tr');
                rows.forEach(row => {
                    const nameCell = row.querySelector('td:nth-child(2)');
                    if (nameCell && nameCell.textContent.includes(entry.fullName)) {
                        const timeCell = row.querySelector('td:nth-child(3)');
                        if (timeCell) {
                            const timeSpan = timeCell.querySelector('span');
                            if (timeSpan) {
                                const currentText = timeSpan.textContent.trim();
                                const newText = `${hours}h ${mins}m`;
                                if (currentText !== newText) {
                                    animateTime(timeSpan, 0, 0, hours, mins);
                                }
                            }
                        }
                    }
                });
            });
        }
        
        // Update current user stats
        function updateCurrentUserStats(rank, hours) {
            // Update rank - find the rank element in the stats section
            const rankContainer = document.querySelector('.flex.flex-col.px-5.py-3:has(.text-xs:contains("YOUR RANK"))');
            if (rankContainer) {
                const rankEl = rankContainer.querySelector('.text-xl.font-bold');
                if (rankEl) {
                    const newRank = rank > 0 ? `#${rank}` : '#-';
                    if (rankEl.textContent.trim() !== newRank) {
                        rankEl.textContent = newRank;
                    }
                }
            }
            
            // Update hours
            const hoursEl = document.getElementById('currentUserHours');
            if (hoursEl) {
                const h = Math.floor(hours);
                const m = Math.floor((hours - h) * 60);
                const oldHours = parseInt(hoursEl.getAttribute('data-hours')) || 0;
                const oldMins = parseInt(hoursEl.getAttribute('data-minutes')) || 0;
                
                if (h !== oldHours || m !== oldMins) {
                    animateTime(hoursEl, oldHours, oldMins, h, m);
                    hoursEl.setAttribute('data-hours', h);
                    hoursEl.setAttribute('data-minutes', m);
                }
            }
        }
        
        // Animate number change
        function animateNumber(element, from, to, suffix = '') {
            if (!element) return;
            
            const duration = 800;
            const startTime = Date.now();
            const difference = parseFloat(to) - parseFloat(from);
            
            function update() {
                const elapsed = Date.now() - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const current = parseFloat(from) + (difference * easeOut);
                
                element.textContent = Math.round(current) + suffix;
                
                if (progress < 1) {
                    requestAnimationFrame(update);
                } else {
                    element.textContent = to + suffix;
                }
            }
            
            update();
        }
        
        // Animate time change
        function animateTime(element, fromHours, fromMins, toHours, toMins) {
            if (!element) return;
            
            const duration = 600;
            const startTime = Date.now();
            const hoursDiff = toHours - fromHours;
            const minsDiff = toMins - fromMins;
            
            function update() {
                const elapsed = Date.now() - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);
                
                const currentHours = Math.round(fromHours + (hoursDiff * easeOut));
                const currentMins = Math.round(fromMins + (minsDiff * easeOut));
                
                element.textContent = `${currentHours}h ${currentMins}m`;
                
                if (progress < 1) {
                    requestAnimationFrame(update);
                } else {
                    element.textContent = `${toHours}h ${toMins}m`;
                    if (element.hasAttribute('data-hours')) {
                        element.setAttribute('data-hours', toHours);
                        element.setAttribute('data-minutes', toMins);
                    }
                }
            }
            
            update();
        }
        
        // Smooth number animation on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Add fade-in and scale animation to numbers
            const numberElements = document.querySelectorAll('[data-hours], [data-value], [data-progress]');
            numberElements.forEach((el, index) => {
                el.style.opacity = '0';
                el.style.transform = 'scale(0.9) translateY(5px)';
                setTimeout(() => {
                    el.style.transition = 'opacity 0.5s ease-out, transform 0.5s ease-out';
                    el.style.opacity = '1';
                    el.style.transform = 'scale(1) translateY(0)';
                }, 100 + (index * 30));
            });
            
            // Animate progress bar with smooth transition
            const progressBar = document.querySelector('[data-progress]');
            if (progressBar) {
                const targetWidth = parseFloat(progressBar.getAttribute('data-progress')) || 0;
                progressBar.style.width = '0%';
                progressBar.style.transition = 'width 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
                setTimeout(() => {
                    progressBar.style.width = targetWidth + '%';
                }, 400);
            }
            
            // Animate streak circle
            const streakCircle = document.querySelector('.stroke-current.text-primary');
            if (streakCircle) {
                streakCircle.style.transition = 'stroke-dashoffset 1s cubic-bezier(0.4, 0, 0.2, 1)';
            }
        });
    </script>
}
