                                                     onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                <div class="w-full h-full flex items-center justify-center text-slate-600 dark:text-slate-300 font-semibold text-sm" style="display: none;">
