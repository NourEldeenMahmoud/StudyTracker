        function enableTodoDrag(list) {
            let dragged = null;

            list.querySelectorAll('li').forEach(li => {
                li.addEventListener('dragstart', e => {
                    dragged = li;
                    li.classList.add('opacity-50');
                });
                li.addEventListener('dragend', () => {
                    if (dragged) dragged.classList.remove('opacity-50');
                    const order = Array.from(list.querySelectorAll('li')).map(x => x.dataset.id);
                    dragged = null;
                    if (order.length) {
                        todoFetch('/Todo/Reorder', { order }).catch(() => {
                            console.error('Failed to persist todo order');
                        });
                    }
                });
                li.addEventListener('dragover', e => {
                    e.preventDefault();
                    if (!dragged || dragged === li) return;
                    const rect = li.getBoundingClientRect();
                    const before = (e.clientY - rect.top) < (rect.height / 2);
                    if (before) {
                        list.insertBefore(dragged, li);
                    } else {
                        list.insertBefore(dragged, li.nextSibling);
                    }
                });
            });
        }

