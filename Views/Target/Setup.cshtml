@model StudyTracker.Models.ViewModels.WeeklyTargetViewModel
@{
    ViewData["Title"] = "Setup Weekly Target";
    Layout = "_UserLayout";
}

<main class="flex-grow flex justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col w-full max-w-[600px]">
        <!-- Page Header -->
        <div class="mb-8">
            <div class="flex flex-col gap-2">
                <h1 class="text-slate-900 dark:text-white text-3xl sm:text-4xl font-black leading-tight tracking-tight">Weekly Target Setup</h1>
                <p class="text-slate-500 dark:text-slate-400 text-base sm:text-lg font-normal">Set your weekly target; your daily goal is the same each day of the week.</p>
            </div>
        </div>

        <!-- Form Container -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 lg:p-10 shadow-sm border border-slate-100 dark:border-slate-800">
            <form asp-action="Setup" method="post" class="flex flex-col gap-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 dark:bg-red-900/20 px-4 py-3 rounded-lg border border-red-200 dark:border-red-800"></div>

                <!-- Daily Target: Hours + Minutes -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium">Daily Target</label>
                    <div class="flex gap-3">
                        <!-- Hours -->
                        <div class="relative flex-1 group">
                            <input asp-for="Hours" type="number" min="0" max="23" placeholder="0"
                                   class="w-full h-14 pl-4 pr-14 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-base" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 uppercase tracking-wider group-focus-within:text-primary transition-colors pointer-events-none">hrs</span>
                        </div>
                        <!-- Minutes -->
                        <div class="relative flex-1 group">
                            <input asp-for="Minutes" type="number" min="0" max="59" placeholder="0"
                                   class="w-full h-14 pl-4 pr-14 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-base" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 uppercase tracking-wider group-focus-within:text-primary transition-colors pointer-events-none">min</span>
                        </div>
                    </div>
                    <span asp-validation-for="Hours" class="text-red-500 text-xs"></span>
                    <span asp-validation-for="Minutes" class="text-red-500 text-xs"></span>

                    <!-- Live preview -->
                    <div id="targetPreview" class="flex items-center gap-2 px-4 py-2.5 bg-primary/5 dark:bg-primary/10 rounded-lg border border-primary/20">
                        <span class="material-symbols-outlined text-primary text-[18px]">schedule</span>
                        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">
                            Daily target: <span id="previewText" class="text-primary font-bold">@Model.Hours h @Model.Minutes m</span>
                            <span id="previewMinutes" class="text-slate-400 dark:text-slate-500 ml-1">(@(Model.Hours * 60 + Model.Minutes) min total)</span>
                        </span>
                    </div>
                </div>

                <!-- Week Info (Read-only) -->
                @{
                    var today = DateOnly.FromDateTime(DateTime.UtcNow);
                    var weekStart = StudyTracker.Helpers.DateHelper.GetWeekStartDate(today);
                    var weekEnd = weekStart.AddDays(6);
                }
                <div class="flex items-center gap-2 px-4 py-2 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
                    <span class="material-symbols-outlined text-slate-400 text-[18px]">calendar_today</span>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Week: @weekStart.ToString("MMM dd") – @weekEnd.ToString("MMM dd, yyyy")</span>
                </div>
                <input type="hidden" asp-for="WeekStartDate" value="@weekStart.ToString("yyyy-MM-dd")" />

                <!-- Actions -->
                <div class="flex items-center justify-end gap-4 mt-4 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <a asp-action="Index" class="px-6 py-3 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition-colors text-sm">
                        Cancel
                    </a>
                    <button type="submit" class="group relative px-8 py-3 rounded-xl bg-primary hover:bg-blue-600 text-white font-bold text-sm shadow-lg shadow-blue-500/30 transition-all hover:-translate-y-0.5 active:translate-y-0">
                        <span class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[20px]">check_circle</span>
                            Save Target
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const hoursInput = document.getElementById('Hours');
        const minutesInput = document.getElementById('Minutes');
        const previewText = document.getElementById('previewText');
        const previewMinutes = document.getElementById('previewMinutes');

        function updatePreview() {
            const h = parseInt(hoursInput.value) || 0;
            const m = parseInt(minutesInput.value) || 0;
            const total = h * 60 + m;
            previewText.textContent = h + 'h ' + m + 'm';
            previewMinutes.textContent = '(' + total + ' min total)';
        }

        hoursInput.addEventListener('input', updatePreview);
        minutesInput.addEventListener('input', updatePreview);
    </script>
}
