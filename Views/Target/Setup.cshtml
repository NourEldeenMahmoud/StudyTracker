@model StudyTracker.Models.ViewModels.WeeklyTargetViewModel
@{
    ViewData["Title"] = "Setup Weekly Target";
    Layout = "_UserLayout";
    var userName = ViewBag.UserName as string ?? "User";
}

<main class="flex-grow flex justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col w-full max-w-[600px]">
        <!-- Page Header -->
        <div class="mb-8">
            <div class="flex flex-col gap-2">
                <h1 class="text-slate-900 dark:text-white text-3xl sm:text-4xl font-black leading-tight tracking-tight">Weekly Target Setup</h1>
                <p class="text-slate-500 dark:text-slate-400 text-base sm:text-lg font-normal">Set your daily study goal for this week.</p>
            </div>
        </div>
        
        <!-- Form Container -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 lg:p-10 shadow-sm border border-slate-100 dark:border-slate-800">
            <form asp-action="Setup" method="post" class="flex flex-col gap-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
                
                <!-- Daily Target Hours -->
                <div class="flex flex-col gap-2">
                    <label class="text-slate-900 dark:text-slate-100 text-base font-medium" asp-for="DailyTargetHours">Daily Target Hours</label>
                    <div class="relative group">
                        <input asp-for="DailyTargetHours" type="number" step="0.1" min="0.1" max="16" class="w-full h-14 pl-4 pr-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-all text-base" placeholder="e.g. 3.0" />
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined">schedule</span>
                        </div>
                        <span asp-validation-for="DailyTargetHours" class="text-red-500 text-xs mt-1"></span>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Enter the number of hours you want to study each day (0.1 - 16 hours)</p>
                    </div>
                </div>
                
                <!-- Week Info (Read-only) -->
                @{
                    var today = DateOnly.FromDateTime(DateTime.UtcNow);
                    var weekStart = StudyTracker.Helpers.DateHelper.GetWeekStartDate(today);
                    var weekEnd = weekStart.AddDays(6);
                }
                <div class="flex items-center gap-2 px-4 py-2 bg-primary/5 dark:bg-primary/10 rounded-lg border border-primary/20">
                    <span class="material-symbols-outlined text-primary text-[18px]">calendar_today</span>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Week: @weekStart.ToString("MMM dd") - @weekEnd.ToString("MMM dd, yyyy") (Saturday to Saturday)</span>
                </div>
                <input type="hidden" asp-for="WeekStartDate" value="@weekStart.ToString("yyyy-MM-dd")" />
                
                <!-- Actions -->
                <div class="flex items-center justify-end gap-4 mt-4 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <a asp-action="Index" class="px-6 py-3 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white font-medium transition-colors text-sm">
                        Cancel
                    </a>
                    <button type="submit" class="group relative px-8 py-3 rounded-xl bg-primary hover:bg-blue-600 text-white font-bold text-sm shadow-lg shadow-blue-500/30 transition-all hover:shadow-blue-500/40 hover:-translate-y-0.5 active:translate-y-0">
                        <span class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[20px]">check_circle</span>
                            Save Target
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
