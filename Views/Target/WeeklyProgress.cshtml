@model StudyTracker.Models.ViewModels.DailyProgressViewModel
@{
    ViewData["Title"] = "Weekly Progress";
    Layout = "_UserLayout";
}

@functions {
    string FormatMinutes(int minutes)
    {
        if (minutes <= 0) return "0m";
        var h = minutes / 60;
        var m = minutes % 60;
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }
}

<main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="space-y-1">
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Weekly Progress</h1>
            <p class="text-slate-500 dark:text-slate-400">A detailed breakdown for the week of @Model.WeekStartDate.ToString("MMM dd") – @Model.WeekEndDate.ToString("MMM dd, yyyy").</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
            <div class="flex items-center gap-2">
                <a href="@Url.Action("WeeklyProgress", "Target", new { date = Model.WeekStartDate.AddDays(-7).ToString("yyyy-MM-dd") })"
                   class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shrink-0 active:scale-95">
                    <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                </a>
                <div class="min-w-0 flex-1 px-3 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                    <span class="text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-200 truncate block">@Model.WeekStartDate.ToString("MMM dd") – @Model.WeekEndDate.ToString("MMM dd, yyyy")</span>
                </div>
                <a href="@Url.Action("WeeklyProgress", "Target", new { date = Model.WeekStartDate.AddDays(7).ToString("yyyy-MM-dd") })"
                   class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shrink-0 active:scale-95">
                    <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                </a>
            </div>
            <a asp-controller="Dashboard" asp-action="Index"
               class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-primary hover:bg-primary/90 text-white transition-colors text-sm font-semibold shadow-sm shadow-primary/20 active:scale-95">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                <span>Dashboard</span>
            </a>
        </div>
    </div>

    <!-- Summary Widgets -->
    <section class="grid grid-cols-3 sm:grid-cols-3 gap-3 sm:gap-4">
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-4 sm:p-6">
            <div class="flex items-center gap-2 sm:gap-3 mb-2 sm:mb-3">
                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-primary text-[16px] sm:text-[20px]">schedule</span>
                </div>
                <p class="text-[10px] sm:text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider leading-tight">This Week</p>
            </div>
            <p class="text-xl sm:text-3xl font-black text-slate-900 dark:text-white">@FormatMinutes(Model.WeeklyTotalMinutes)</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-4 sm:p-6">
            <div class="flex items-center gap-2 sm:gap-3 mb-2 sm:mb-3">
                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-emerald-500 text-[16px] sm:text-[20px]">avg_pace</span>
                </div>
                <p class="text-[10px] sm:text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider leading-tight">Daily Avg</p>
            </div>
            <p class="text-xl sm:text-3xl font-black text-slate-900 dark:text-white">@FormatMinutes((int)Math.Round(Model.WeeklyAverageMinutesPerDay))</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-4 sm:p-6">
            <div class="flex items-center gap-2 sm:gap-3 mb-2 sm:mb-3">
                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-amber-500/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-amber-500 text-[16px] sm:text-[20px]">history</span>
                </div>
                <p class="text-[10px] sm:text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider leading-tight">Last Week</p>
            </div>
            <p class="text-xl sm:text-3xl font-black text-slate-900 dark:text-white">@FormatMinutes(Model.PreviousWeekTotalMinutes)</p>
        </div>
    </section>

    <!-- Week Overview -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-4">Week Overview</h2>
        <div class="grid grid-cols-4 sm:grid-cols-4 lg:grid-cols-7 gap-2 sm:gap-3">
            @foreach (var d in Model.WeekDays)
            {
                var isToday = d.Date == TimeZoneHelper.GetTodayInCairo();
                var isSelected = d.Date == Model.SelectedDate;
                var hasStudied = d.StudiedMinutes > 0;
                <a href="@Url.Action("WeeklyProgress", "Target", new { date = d.Date.ToString("yyyy-MM-dd") })"
                   class="rounded-xl border-2 px-2 sm:px-4 py-3 sm:py-4 transition-all hover:scale-[1.02] active:scale-[0.97] cursor-pointer block
                    @(isSelected ? "border-primary bg-primary/10 dark:bg-primary/15 shadow-sm"
                      : isToday ? "border-primary bg-primary/5 dark:bg-primary/10"
                      : hasStudied ? "border-emerald-200 dark:border-emerald-800 bg-emerald-50/50 dark:bg-emerald-900/10"
                      : "border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800")">
                    <p class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">@d.DayName.Substring(0, 3)</p>
                    <p class="text-[10px] sm:text-[11px] mt-0.5 text-slate-500 dark:text-slate-400">@d.Date.ToString("M/d")</p>
                    <p class="text-sm sm:text-lg font-black mt-1.5 sm:mt-2 @(hasStudied ? "text-slate-900 dark:text-white" : "text-slate-300 dark:text-slate-600")">@FormatMinutes(d.StudiedMinutes)</p>
                    @if (isToday && !isSelected)
                    {
                        <span class="inline-block mt-0.5 text-[9px] sm:text-[10px] font-bold text-primary uppercase tracking-wider">Today</span>
                    }
                    @if (isSelected)
                    {
                        <span class="inline-block mt-0.5 text-[9px] sm:text-[10px] font-bold text-primary uppercase tracking-wider">Selected</span>
                    }
                </a>
            }
        </div>
    </section>

    <!-- KPI cards -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
            <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Sessions</p>
            <p class="text-3xl font-black text-slate-900 dark:text-white mt-2">@Model.SessionsCount</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Avg session: @FormatMinutes(Model.AverageSessionMinutes)</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
            <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Streak</p>
            <p class="text-3xl font-black text-slate-900 dark:text-white mt-2">@Model.StreakDays day@(Model.StreakDays == 1 ? "" : "s")</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Consecutive days studied</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm p-6">
            <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Daily Rank</p>
            <p class="text-3xl font-black text-slate-900 dark:text-white mt-2">@(Model.CurrentRank > 0 ? $"#{Model.CurrentRank}" : "—")</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Your position on the leaderboard</p>
        </div>
    </section>

    <!-- Session Details (filtered to selected day by service) -->
    <section class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-slate-900 dark:text-white">Session Details</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@Model.SelectedDate.ToString("dddd, MMM dd, yyyy")</p>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 dark:bg-primary/20 text-xs font-semibold text-primary">
                <span class="material-symbols-outlined text-[14px]">event</span>
                @Model.Sessions.Count session@(Model.Sessions.Count == 1 ? "" : "s")
            </span>
        </div>

        @if (Model.Sessions.Any())
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var s in Model.Sessions)
                {
                    <div class="px-6 py-4">
                        <div class="flex items-start justify-between gap-4">
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-slate-900 dark:text-white">
                                    @TimeZoneHelper.ToCairo(s.CreatedAtUtc).ToString("hh:mm tt")
                                </p>
                            </div>
                            <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 dark:bg-primary/20 px-2.5 py-1 text-[11px] font-semibold text-primary">
                                <span class="material-symbols-outlined text-[14px]">timer</span>
                                @FormatMinutes(s.DurationMinutes)
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(s.Notes))
                        {
                            <div class="mt-3 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800 p-3">
                                <p class="text-sm text-slate-700 dark:text-slate-200 whitespace-pre-wrap">@s.Notes</p>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="px-6 py-14 text-center">
                <span class="material-symbols-outlined text-slate-300 dark:text-slate-600 text-[40px] mb-2">event_busy</span>
                <p class="text-sm text-slate-500 dark:text-slate-400">No sessions logged for @Model.SelectedDate.ToString("MMM dd").</p>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Click a different day above to view its sessions.</p>
            </div>
        }
    </section>
</main>
